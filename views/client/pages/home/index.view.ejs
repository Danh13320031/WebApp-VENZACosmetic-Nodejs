<!DOCTYPE html>
<html lang="en">
  <head>
    <%-include('../../partials/seoMeta.view.ejs', { pageTitle: pageTitle}) %> 

    <%# Styles File %>
    <link rel="stylesheet" href="/client/setup.css" />
    <link rel="stylesheet" href="/client/styles/partials/alert.css" />
    <link rel="stylesheet" href="/client/styles/partials/header.css" />
    <link rel="stylesheet" href="/client/styles/pages/index/index.css" />
    <link rel="stylesheet" href="/client/styles/pages/index/index.responsive.css" />
    <link rel="stylesheet" href="/client/styles/partials/buttonMessage.css" />
    <link rel="stylesheet" href="/client/styles/partials/buttonHotLine.css" />
    <link rel="stylesheet" href="/client/styles/partials/buttonMailTo.css" />
    <link rel="stylesheet" href="/client/styles/partials/buttonScrollToTop.css" />
    <link rel="stylesheet" href="/client/styles/partials/buttonChatBot.css" />
    <link rel="stylesheet" href="/client/styles/partials/couponDetail.css">
    <link rel="stylesheet" href="/client/styles/partials/brandDetail.css">
    <link rel="stylesheet" href="/client/styles/partials/copyClipboard.css">
    <link rel="stylesheet" href="/client/styles/partials/footer.css" />
    <%# End Styles File %> 
    
    <%# Styles Library & Framework Link %> <%# Bootstrap %>
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.5/dist/css/bootstrap.min.css"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
    />
    <%# BoxIcon %>
    <link href="https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css" rel="stylesheet" />
    <%# SlickSlide %>
    <link
      rel="stylesheet"
      type="text/css"
      href="//cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.css"
    />
    <%# End Styles Library & Framework Link %>
  </head>
  <body>
    <%-include('../../partials/alertMessage.view.ejs') %>
    <%-include('../../partials/header.view.ejs', { categoryListTree: categoryTree, homeActive:
    "active", aboutActive: '', productActive: '', newsActive: '', contactActive: '', cartActive: ''
    }); %> <%-include("../../partials/headerMobile.view.ejs") %>

    <main class="main">
      <%# Banner Header %>
      <section class="pt-4 herobanner">
        <div class="container">
          <div class="row gap-md-0 px-2">
            <div class="col-lg-8 col-md-8 col-12 p-0">
              <div class="herobanner-slider button-trans">
                <div class="mx-1 position-relative herobanner-box">
                  <div
                    class="position-absolute top-50 start-50 translate-middle d-flex flex-column align-items-center"
                  >
                    <h1
                      class="heading-font py-0 fw-bold text-center text-white fs-1 d-lg-block d-none"
                    >
                      <div>SUỐI NGUỒN</div>
                      <div>TƯƠI TRẺ</div>
                    </h1>
                    <p
                      class="content-font fst-italic text-white text-center mb-0 d-lg-block d-none"
                    >
                      Đẹp theo bản sắc riêng biệt
                    </p>
                    <a
                      href="/products"
                      class="button-primary text-decoration-none d-flex align-items-center herobanner-link"
                    >
                      Xem nhiều hơn
                      <i class="fa-solid fa-circle-play ms-2 d-lg-block d-none"></i>
                    </a>
                  </div>
                  <img src="/client/images/banner/hero-banner-02.jpg" alt="" width="100%" />
                </div>
                <div class="mx-1 herobanner-box">
                  <div
                    class="position-absolute d-flex gap-2 flex-column align-items-start"
                    style="left: 41.5%; top: 50%; transform: translate(0%, -50%)"
                  >
                    <p
                      class="content-font text-capitalize fst-italic mb-0 p-2 bg-white d-lg-block d-none"
                      style="color: var(--primary-color)"
                    >
                      Cải Tiến Mới
                    </p>
                    <h1
                      class="heading-font py-0 fw-bold text-start fs-1 d-lg-block d-none"
                      style="color: var(--dark-gray-color)"
                    >
                      <div>BỀN MÀU</div>
                      <div>VƯỢT TRỘI</div>
                    </h1>
                    <a
                      href="/products"
                      class="button-secondary text-decoration-none herobanner-link"
                    >
                      Xem thêm
                      <i class="fa-solid fa-circle-play ms-2"></i>
                    </a>
                  </div>
                  <img src="/client/images/banner/hero-banner-01.png" alt="" width="100%" />
                </div>
              </div>
            </div>
            <div class="col-4 p-0 d-md-block d-none">
              <div class="herobanner-image d-flex flex-column gap-0">
                <div class="banner flex-grow-1">
                  <a href="/products">
                    <img src="/client/images/banner/hero-banner-03.jpg" alt="" width="100%" />
                  </a>
                </div>
                <div class="banner flex-grow-1">
                  <a href="/products">
                    <img src="/client/images/banner/hero-banner-04.jpg" alt="" width="100%" />
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
      <%# End Banner Header %> 
      
      <%# Product Type Card %>
      <section class="product-type">
        <div class="container">
          <h3 class="heading-font text-center product-type-title">Danh mục sản phẩm</h3>
          <div class="row g-2">
            <div class="col-lg-2 col-md-4 col-6 product-type-item">
              <div class="card-bg">
                <div class="card-overlay"></div>
                <div class="card-text">
                  <a
                    href="/products?category=haircare"
                    class="content-font text-decoration-none fw-bold card-title"
                    >Hair care</a
                  >
                  <span class="content-font card-content">Chăm sóc tóc</span>
                </div>
                <img src="/client/images/category/category (1).jpg" alt="" class="card-img" />
              </div>
            </div>
            <div class="col-lg-2 col-md-4 col-6 product-type-item">
              <div class="card-bg">
                <div class="card-overlay"></div>
                <div class="card-text">
                  <a
                    href="/products?category=skincare"
                    class="content-font text-decoration-none fw-bold card-title"
                    >Skin care</a
                  >
                  <span class="content-font card-content">Chăm sóc da</span>
                </div>
                <img src="/client/images/category/category (1).jpg" alt="" class="card-img" />
              </div>
            </div>
            <div class="col-lg-2 col-md-4 col-6 product-type-item">
              <div class="card-bg">
                <div class="card-overlay"></div>
                <div class="card-text">
                  <a
                    href="/products?category=bodycare"
                    class="content-font text-decoration-none fw-bold card-title"
                    >Body care</a
                  >
                  <span class="content-font card-content">Chăm sóc cơ thể</span>
                </div>
                <img src="/client/images/category/category (1).jpg" alt="" class="card-img" />
              </div>
            </div>
            <div class="col-lg-2 col-md-4 col-6 product-type-item">
              <div class="card-bg">
                <div class="card-overlay"></div>
                <div class="card-text">
                  <a
                    href="/products?category=nailcare"
                    class="content-font text-decoration-none fw-bold card-title"
                    >Nail care</a
                  >
                  <span class="content-font card-content">Chăm sóc móng</span>
                </div>
                <img src="/client/images/category/category (1).jpg" alt="" class="card-img" />
              </div>
            </div>
            <div class="col-lg-2 col-md-4 col-6 product-type-item">
              <div class="card-bg">
                <div class="card-overlay"></div>
                <div class="card-text">
                  <a
                    href="/products?category=makeup"
                    class="content-font text-decoration-none fw-bold card-title"
                    >Make up</a
                  >
                  <span class="content-font card-content">Trang điểm</span>
                </div>
                <img src="/client/images/category/category (1).jpg" alt="" class="card-img" />
              </div>
            </div>
            <div class="col-lg-2 col-md-4 col-6 product-type-item">
              <div class="card-bg">
                <div class="card-overlay"></div>
                <div class="card-text">
                  <a
                    href="/products?category=perfume"
                    class="content-font text-decoration-none fw-bold card-title"
                    >Perfume</a
                  >
                  <span class="content-font card-content">Nước hoa</span>
                </div>
                <img src="/client/images/category/category (1).jpg" alt="" class="card-img" />
              </div>
            </div>
          </div>
        </div>
      </section>
      <%# End Product Type Card %> 
      
      <%# Feature Card Slide %>
      <section class="card-feature">
        <div class="container">
          <h3 class="heading-font text-center card-feature-heading">Sản Phẩm Nổi Bật</h3>
          <div class="row">
            <div class="col-12">
              <div class="card-feature-slider button-trans">
                <% productFeatureList.forEach((product) => { %>
                <div class="mx-1 card-bg" title="<%= product.title %>">
                  <% if(product.discount > 0) { %>
                  <div class="card-discount-badge">
                    <img src="/client/images/product/sale-badge/sale-badge (1).png" width="40px" />
                  </div>
                  <span class="content-font text-white card-discount-text"
                    >-<%= product.discount %>%</span
                  >
                  <% } %>
                  <div class="card-image">
                    <img
                      src="<%= product.thumbnail %>"
                      alt="product"
                      width="100%"
                      class="card-thumbnail"
                    />
                    <div class="card-link">
                      <a
                        href="/products/detail/<%= product.slug %>"
                        class="content-font card-link-detail"
                        >Xem chi tiết</a
                      >
                    </div>
                  </div>
                  <div class="content-font overflow-x-hidden text-nowrap card-title mt-1">
                    <% if(product.title.length > 25) { %> <%= product.title.slice(0, 25) + '...' %>
                    <% } else { %> <%= product.title %><% } %>
                  </div>
                  <div class="card-box d-flex justify-content-between align-items-center">
                    <h5 class="title-font card-price">
                      <%= new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND'
                      }).format(Number.parseFloat(product.price - (product.price / 100 *
                      product.discount))) %>
                    </h5>
                    <div class="card-favorite <% if(product.isLike) { %>active<% } %>">
                      <button class="border-0 d-md-block d-none btn-add-favorite" data-id="<%= product.id %>">
                        <i class="bi bi-suit-heart-fill"></i>
                      </button>
                    </div>
                  </div>
                  <div class="content-font d-lg-block d-none text-danger text-decoration-line-through">
                    Giá gốc: <%= new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND'
                    }).format(product.price) %>
                  </div>
                  <div class="card-rating d-flex justify-content-between align-items-center">
                    <div class="card-star">
                      <% for(let i = 1; i <= product.rating; i++) { %>
                      <i class="bi bi-star-fill"></i>
                      <% } %>
                    </div>
                    <form <% if(product.stock>
                      0) { %> action="/cart/add/<%= product.id %>" method="POST" <% } %>>
                      <button type="submit" class="border-0 bg-transparent">
                        <i title="add to cart" class="bi bi-bag-check-fill"></i>
                      </button>
                    </form>
                  </div>
                </div>
                <%# End Card %> <% }) %>
              </div>
            </div>
          </div>
        </div>
      </section>
      <%# End Feature Card Slide %> 
      
      <%# Banner Image %>
      <section class="banner1 pt-5">
        <div class="container">
          <div class="row">
            <div class="col-12">
              <a href="/products" class="banner1-link"
                ><img
                  src="/client/images/banner/banner-ads-08 (2).png"
                  alt=""
                  width="100%"
                  class="banner1-img"
              /></a>
            </div>
          </div>
        </div>
      </section>
      <%# End Banner Image %> 
      
      <%# Sale Card Slide %>
      <section class="card-sale">
        <div class="container">
          <h3 class="heading-font text-center card-sale-heading">Sản Phẩm Đang Giảm Giá</h3>
          <div class="row">
            <div class="col-12">
              <div class="card-sale-slider button-trans">
                <% productSaleList.forEach((product) => { %>
                <div class="mx-1 card-bg" title="<%= product.title %>">
                  <% if(product.discount > 0) { %>
                  <div class="card-discount-badge">
                    <img src="/client/images/product/sale-badge/sale-badge (1).png" width="40px" />
                  </div>
                  <span class="content-font text-white card-discount-text"
                    >-<%= product.discount %>%</span
                  >
                  <% } %>
                  <div class="card-image">
                    <img
                      src="<%= product.thumbnail %>"
                      alt="product"
                      width="100%"
                      class="card-thumbnail"
                    />
                    <div class="card-link">
                      <a
                        href="/products/detail/<%= product.slug %>"
                        class="content-font card-link-detail"
                      >
                        Xem chi tiết
                      </a>
                    </div>
                  </div>
                  <div class="content-font overflow-x-hidden text-nowrap card-title mt-1">
                    <% if(product.title.length > 25) { %> <%= product.title.slice(0, 25) + '...' %>
                    <% } else { %> <%= product.title %><% } %>
                  </div>
                  <div class="card-box d-flex justify-content-between align-items-center">
                    <h5 class="title-font card-price">
                      <%= new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND'
                      }).format(Number.parseFloat(product.price - (product.price / 100 *
                      product.discount)))%>
                    </h5>
                    <div class="card-favorite <% if(product.isLike) { %>active<% } %>">
                      <button class="border-0 d-md-block d-none btn-add-favorite" data-id="<%= product.id %>">
                        <i class="bi bi-suit-heart-fill"></i>
                      </button>
                    </div>
                  </div>
                  <div class="content-font d-lg-block d-none text-danger text-decoration-line-through">
                    Giá gốc: <%= new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND'
                    }).format(product.price) %>
                  </div>
                  <div class="card-rating d-flex justify-content-between align-items-center">
                    <div class="card-star">
                      <% for(let i = 1; i <= product.rating; i++) { %>
                      <i class="bi bi-star-fill"></i>
                      <% } %>
                    </div>
                    <form <% if(product.stock>
                      0) { %> action="/cart/add/<%= product.id %>" method="POST" <% } %>>
                      <button type="submit" class="border-0 bg-transparent">
                        <i title="add to cart" class="bi bi-bag-check-fill"></i>
                      </button>
                    </form>
                  </div>
                </div>
                <%# End Card %> <% }) %>
              </div>
            </div>
          </div>
        </div>
      </section>
      <%# End Sale Card Slide %>

      <div class="card-coupon-detail-list">
        <% couponList.forEach((coupon) => { %>
          <%-include('../../partials/couponDetail.view.ejs', { coupon: coupon }) %>
        <% }) %>
      </div>

      <%#  Coupon Card Slide %>
      <section class="card-coupon">
        <div class="container">
          <h3 class="heading-font text-center card-sale-heading">
            Mã khuyến mãi
          </h3>
          <div class="row">
            <div class="col-12">
              <div class="w-100 d-flex justify-content-center card-coupon-slider button-trans">
                <% couponList.forEach((coupon) => { %>
                <div class="mx-2 card-bg">
                  <div
                    class="w-100 h-100 border border-1 border-gray position-relative bg-white px-1 py-3 d-flex align-items-center card-content"
                    style="filter: drop-shadow(1px 0px 0.5px black)"
                  >
                    <div
                      class="position-absolute h-100 top-0 start-0 translate-middle-x z-1 bg-white card-image-line"
                    >
                      <img
                        src="/client/images/coupon/coupon-line-01.png"
                        alt="coupon"
                        height="100%"
                        class="card-thumbnail"
                        style="filter: drop-shadow(-1px 0px 0.5px black)"
                      />
                    </div>
                    <div class="h-100 d-flex gap-2 align-items-center">
                      <div
                        class="h-100 d-flex align-items-center border border-right-1 border-left-0 border-top-0 border-bottom-0 card-value"
                      >
                        <div
                          class="heading-font p-2 m-2 rounded-2 text-white"
                          style="background-color: var(--dark-gray-color)"
                        >
                          -<%= coupon.valueType === 'amount' ? coupon.value / 1000 + 'K' :
                          coupon.value + '%' %>
                        </div>
                      </div>
                      <div class="card-info">
                        <div class="d-flex flex-wrap gap-2 align-items-center">
                          <div
                            class="content-font fw-bold text-copy card-code"
                            data-id="<%= coupon._id %>" text-copy
                          >
                            <span style="color: var(--primary-color)"><%= coupon.code %></span>
                            <i class="py-1 px-2 rounded-1 fa-regular fa-copy btn-copy" data-id="<%= coupon._id %>" btn-copy></i>
                          </div>
                        </div>
                        <div class="content-font card-description">
                          <span class="d-md-block d-none">
                            Áp dụng cho đơn hàng từ <%= new Intl.NumberFormat('vi-VN', { style:
                            'currency', currency: 'VND' }).format(coupon.minAmount) %>.
                          </span>
                          <button class="text-decoration-underline border-0 bg-transparent fw-bold" card-coupon-detail data-id="<%= coupon._id %>">Xem chi tiết</button>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
                <% }) %>
              </div>
            </div>
          </div>
        </div>
      </section>
      <%# End Coupon Card Slide %>

      <%# Flash Sale Card Slide %> 
      <% if(productFlashSaleList.length > 0) { %>
      <section class="card-flash-sale mt-5">
        <div class="container">
          <div
            class="p-4 rounded-4 card-flash-sale-container"
            style="background-color: var(--primary-color)"
          >
            <div class="row col-12">
              <div class="d-flex justify-content-center">
                <div class="mb-2 d-flex flex-column align-items-center gap-2">
                  <h3
                    class="heading-font py-2 px-4 ms-2 text-center fst-italic card-flash-sale-heading"
                    style="
                      color: var(--primary-color);
                      background-color: var(--dark-gray-color);
                      text-shadow: 0px 0px 10px var(--primary-color);
                      transform: skewX(-10deg);
                    "
                  >
                    <img
                      src="/client/images/flash_sale_unscreen.gif"
                      alt="hot-sale"
                      width="18px"
                      style="
                        transform: scale(2);
                        filter: drop-shadow(0px 0px 2px var(--primary-color));
                      "
                    />
                    Flash Sale
                  </h3>
                  <div
                    class="heading-font py-0 text-center card-flash-sale-time"
                    style="
                      color: var(--light-primary-color);
                      text-shadow: 0px 0px 10px var(--light-primary-color);
                      transform: skewX(-10deg);
                    "
                    data-time="<%= `${productFlashSaleDuration.dayNumber}:${productFlashSaleDuration.hourNumber}:${productFlashSaleDuration.minuteNumber}:${productFlashSaleDuration.secondNumber}` %>"
                    card-flash-sale-time
                  >
                    <%= productFlashSaleDuration.dayNumber %> days : <%=
                    productFlashSaleDuration.hourNumber %> hours : <%=
                    productFlashSaleDuration.minuteNumber %> minutes : <%=
                    productFlashSaleDuration.secondNumber %> seconds
                  </div>
                </div>
              </div>
            </div>
            <div class="row">
              <div class="col-12 d-flex justify-content-center">
                <div
                  class="w-100 d-flex gap-lg-2 gap-1 justify-content-center card-flash-sale-slider button-trans"
                  data-length="<%= productFlashSaleList.length %>"
                >
                  <% productFlashSaleList.forEach((product) => { %>
                  <div class="mx-1 card-bg" title="<%= product.title %>">
                    <% if(product.discount > 0) { %>
                    <div class="card-discount-badge">
                      <img src="/client/images/product/sale-badge/sale-badge (1).png" width="40px" />
                    </div>
                    <span class="content-font text-white card-discount-text"
                      >-<%= product.discount %>%</span
                    >
                    <% } %>
                    <div class="card-image">
                      <img
                        src="<%= product.thumbnail %>"
                        alt="product"
                        width="100%"
                        class="card-thumbnail"
                      />
                      <div class="card-link">
                        <a
                          href="/products/detail/<%= product.slug %>"
                          class="content-font card-link-detail"
                        >
                          Xem chi tiết
                        </a>
                      </div>
                    </div>
                    <div class="content-font overflow-x-hidden text-nowrap card-title mt-1">
                      <% if(product.title.length > 25) { %> <%= product.title.slice(0, 25) + '...'
                      %> <% } else { %> <%= product.title %><% } %>
                    </div>
                    <div class="card-box d-flex justify-content-between align-items-center">
                      <h5 class="title-font card-price">
                        <%= new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND'
                        }).format(Number.parseFloat(product.price - (product.price / 100 *
                        product.discount)))%>
                      </h5>
                      <div class="card-favorite <% if(product.isLike) { %>active<% } %>">
                        <button class="border-0 d-md-block d-none btn-add-favorite" data-id="<%= product.id %>">
                          <i class="bi bi-suit-heart-fill"></i>
                        </button>
                      </div>
                    </div>
                    <div class="content-font d-lg-block d-none text-danger text-decoration-line-through">
                      Giá gốc: <%= new Intl.NumberFormat('vi-VN', { style: 'currency', currency:
                      'VND' }).format(product.price) %>
                    </div>
                    <div class="card-rating d-flex justify-content-between align-items-center">
                      <div class="card-star">
                        <% for(let i = 1; i <= product.rating; i++) { %>
                        <i class="bi bi-star-fill"></i>
                        <% } %>
                      </div>
                      <form <% if(product.stock>
                        0) { %> action="/cart/add/<%= product.id %>" method="POST" <% } %>>
                        <button type="submit" class="border-0 bg-transparent">
                          <i title="add to cart" class="bi bi-bag-check-fill"></i>
                        </button>
                      </form>
                    </div>
                  </div>
                  <%# End Card %> 
                  <% }) %>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
      <% } %> 
      <%# End Flash Sale Card Slide %>

      <div class="card-coupon-detail-list">
        <% productBrandList.forEach((brand) => { %>
          <%-include('../../partials/brandDetail.view.ejs', { brand: brand }) %>
        <% }) %>
      </div>

      <%# Product Brand %>
      <section class="card-brand">
        <div class="container">
          <h3 class="heading-font pb-0 text-center card-feature-heading">Thương hiệu nổi Bật</h3>
          <div class="row">
            <div class="col-12">
              <div class="card-brand-slider button-trans">
                <% productBrandList.forEach((brand) => { %>
                <div class="d-flex flex-column justify-content-center">
                  <div
                  class="d-flex flex-column justify-content-center align-items-center h-100 mx-1 card-brand-item"
                  title="<%= brand.title %>"
                  style="aspect-ratio: 1/1;"
                  >
                    <img src="<%= brand.thumbnail %>" alt="<%= brand.title %>" width="140px" />
                  </div>
                  <button class="button-secondary mx-1" card-brand-detail data-id="<%= brand._id %>"><%= brand.title %></button>
                </div>
                <% }) %>
              </div>
            </div>
          </div>
        </div>
      </section>
      <%# End Product Brand %> 

      <%# Post Card Section %>
      <section class="card-post">
        <div class="container">
          <h3 class="heading-font text-center post-title">Các bài viết về mỹ phẩm</h3>
          <div class="row">
            <div class="col-lg-5 col-12 mb-lg-0 mb-2">
              <% if(postFeatured) { %>
              <div class="bg-white p-2 card-bg">
                <div class="position-relative h-100 card-image">
                  <a href="" class="card-link">
                    <img src="<%= postFeatured.thumbnail %>" alt="" class="card-img" />
                  </a>
                  <div
                    class="w-100 h-100 position-absolute top-0 start-0 bg-black opacity-50 card-overlay"
                  ></div>
                  <a
                    href="/posts/detail/<%= postFeatured.slug %>"
                    class="button-primary position-absolute top-50 start-50 translate-middle shadow bg-transparent border border-color-white text-capitalize card-link-detail"
                  >
                    Xem chi tiết
                  </a>
                </div>
                <div class="card-content">
                  <a
                    href="/posts/detail/<%= postFeatured.slug %>"
                    class="title-font text-decoration-none card-title"
                    title="<%= postFeatured.title %>"
                  >
                    <%= `${postFeatured.title.substring(0, 50)}${postFeatured.title.length > 50 ?
                    '...' : ''}` %>
                  </a>
                  <div class="content-font fs-6 card-time">
                    <i class="bi bi-clock me-1"></i><%=
                    moment(postFeatured.postedBy.postedAt).format('HH:mm - DD/MM/YYYY') %>
                  </div>
                  <p
                    class="content-font mb-0 text-justify card-summary"
                    title="<%= postFeatured.summary %>"
                  >
                    <%= `${postFeatured.summary.substring(0, 100)}${postFeatured.summary.length >
                    100 ? '...' : ''}` %>
                  </p>
                </div>
              </div>
              <% } %>
              <div class="w-100 d-flex jutify-content-end align-items-center mt-2">
                <a
                  href="/posts"
                  class="button-secondary w-100 d-lg-block d-none text-center text-decoration-none"
                >
                  Xem tất cả<i class="bi bi-arrow-right-short ms-2"></i>
                </a>
              </div>
            </div>
            <div class="col-lg-7 col-12">
              <div class="gap-2 row">
                <% if(postList && postList.length > 0) { %> <% postList.forEach((post) => { %>
                <div class="col-12">
                  <div class="d-flex gap-2 bg-white p-2 card-bg">
                    <div class="card-image">
                      <a href="" class="card-link">
                        <img
                          src="<%= post.thumbnail %>"
                          alt="<%= post.title %>"
                          style="width: 120px; height: 120px"
                          class="card-img"
                        />
                      </a>
                    </div>
                    <div class="flex-shrink-1 flex-grow-1 card-content">
                      <a
                        href="/posts/detail/<%= post.slug %>"
                        class="title-font text-decoration-none card-title"
                        title="<%= post.title %>"
                      >
                        <%= `${post.title.substring(0, 50)}${post.title.length > 50 ? '...' : ''}`
                        %>
                      </a>
                      <p class="content-font mb-0 d-lg-block d-none text-justify card-summary">
                        <%= `${post.summary.substring(0, 100)}${post.summary.length > 100 ? '...' :
                        ''}` %>
                      </p>
                      <div class="d-flex justify-content-between mt-2">
                        <div class="content-font fw-bold card-time">
                          <i class="bi bi-clock me-1"></i>
                          <%= moment(post.postedBy.postedAt).format('HH:mm - DD/MM/YYYY') %>
                        </div>
                        <div class="card-button">
                          <a
                            href="/posts/detail/<%= post.slug %>"
                            class="button-primary text-lowercase card-link-detail"
                          >
                            Xem chi tiết
                          </a>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
                <% }) %> <% } %>
              </div>
              <div class="w-100 d-flex jutify-content-end align-items-center mt-2">
                <a
                  href="/posts"
                  class="button-secondary w-100 d-lg-none d-block text-center text-decoration-none"
                >
                  Xem tất cả<i class="bi bi-arrow-right-short ms-2"></i>
                </a>
              </div>
            </div>
          </div>
        </div>
      </section>
      <%# End Post Card Section %>
    </main>

    <%-include('../../partials/buttonMessage.view.ejs') %>
    <%-include('../../partials/buttonHotLine.view.ejs') %>
    <%-include('../../partials/buttonMailTo.view.ejs') %>
    <%-include('../../partials/buttonScrollToTop.view.ejs') %>
    <%-include('../../partials/buttonChatBot.view.ejs') %>
    <%-include('../../partials/footer.view.ejs') %>

    <form
      action="/cart/delete"
      method="POST"
      class="d-none form-delete-product-cart"
      id="form-delete-product-cart"
    ></form>

    <form
      action="/cart/change-quantity"
      method="POST"
      class="d-none form-change-quantity-cart"
      id="form-change-quantity-cart"
    ></form>

    <form
      action="/products/add-favorite"
      method="POST"
      class="d-none form-add-favorite"
      id="form-add-favorite"
    ></form>

