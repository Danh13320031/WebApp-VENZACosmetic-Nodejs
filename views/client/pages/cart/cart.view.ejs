<!DOCTYPE html>
<html lang="en">
  <head>
    <%-include('../../partials/seoMeta.view.ejs', { pageTitle: pageTitle}) %>

    <%# Styles File %>
    <link rel="stylesheet" href="/client/setup.css" />
    <link rel="stylesheet" href="/client/styles/partials/alert.css" />
    <link rel="stylesheet" href="/client/styles/partials/header.css" />
    <link rel="stylesheet" href="/client/styles/pages/index/index.css" />
    <link rel="stylesheet" href="/client/styles/pages/index/index.responsive.css" />
    <link rel="stylesheet" href="/client/styles/partials/breadcrumb.css" />
    <link rel="stylesheet" href="/client/styles/partials/pagination.css" />
    <link rel="stylesheet" href="/client/styles/partials/buttonMessage.css" />
    <link rel="stylesheet" href="/client/styles/partials/buttonHotLine.css" />
    <link rel="stylesheet" href="/client/styles/partials/buttonMailTo.css" />
    <link rel="stylesheet" href="/client/styles/partials/buttonScrollToTop.css" />
    <link rel="stylesheet" href="/client/styles/partials/buttonChatBot.css" />
    <link rel="stylesheet" href="/client/styles/partials/copyClipboard.css" />
    <link rel="stylesheet" href="/client/styles/pages/cart/cart.css" />
    <link rel="stylesheet" href="/client/styles/partials/footer.css" />
    <%# End Styles File %>

    <%# Styles Library & Framework Link %>
    <%# Bootstrap %>
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.5/dist/css/bootstrap.min.css"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
    />
    <%# BoxIcon %>
    <link href="https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css" rel="stylesheet" />
    <%# SlickSlide %>
    <link
      rel="stylesheet"
      type="text/css"
      href="//cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.css"
    />
    <%# End Styles Library & Framework Link %>
  </head>
  <body>
    <%-include('../../partials/alertMessage.view.ejs') %>
    <%-include('../../partials/header.view.ejs', { categoryListTree: categoryTree, homeActive: "",
    aboutActive: '', productActive: '', newsActive: '', contactActive: '', cartActive: 'active' });
    %> <%-include("../../partials/headerMobile.view.ejs") %>

    <main class="main">
      <%-include('../../partials/breadcrumb.view.ejs', { pageTitle: pageTitle, pageUrl: pageUrl })%>

      <%# Available Coupon List %>
      <section class="position-fixed top-0 start-0 w-100 h-100 d-flex justify-content-center align-items-center cart-coupon-list" id="cart-coupon-modal">
        <div class="position-absolute top-0 start-0 w-100 h-100 bg-black bg-opacity-50 cart-coupon-overlay" id="cart-coupon-overlay"></div>
        <div class="position-absolute shadow d-flex flex-column justify-content-center align-items-center coupon-list-box">
          <div class="coupon-list-modal">
            <div class="title-font p-4 d-flex justify-content-between align-items-center rounded-top-2 bg-white border border-bottom-1 card-coupon-title">
              Các mã giảm giá có thể sử dụng
              <i class="button-icon-primary bi bi-x-lg" card-coupon-hide></i>
            </div>
            <ul class="d-flex flex-column gap-2 overflow-y-scroll bg-white p-4 mb-0 rounded-bottom-2 coupon-list">
            <% if(couponList && couponList.length > 0) { %>
            <% couponList.forEach((coupon) => { %>
              <li class="coupon-item">
                <div class="card-bg-coupon">
                <div
                  class="w-100 h-100 border border-1 border-gray position-relative bg-white px-1 py-3 d-flex align-items-center card-content"
                  style="filter: drop-shadow(1px 0px 0.5px black)"
                >
                  <div
                    class="position-absolute h-100 top-0 start-0 translate-middle-x z-1 bg-white card-image-line"
                  >
                    <img
                      src="/client/images/coupon/coupon-line-01.png"
                      alt="coupon"
                      height="100%"
                      class="card-thumbnail"
                      style="filter: drop-shadow(-1px 0px 0.5px black)"
                    />
                  </div>
                  <div class="h-100 d-flex gap-2 align-items-center">
                    <div
                      class="h-100 d-flex align-items-center border border-right-1 border-left-0 border-top-0 border-bottom-0 card-value"
                    >
                      <div
                        class="heading-font p-2 m-2 rounded-2 text-white"
                        style="background-color: var(--dark-gray-color)"
                      >
                        -<%= coupon.valueType === 'amount' ? coupon.value / 1000 + 'K' :
                        coupon.value + '%' %>
                      </div>
                    </div>
                    <div class="card-info">
                      <div class="d-flex flex-wrap gap-2 align-items-center">
                        <div
                          class="content-font fw-bold text-copy card-code"
                          data-id="<%= coupon._id %>" text-copy
                        >
                          <span style="color: var(--primary-color)"><%= coupon.code %></span>
                          <i class="py-1 px-2 rounded-1 fa-regular fa-copy btn-copy" data-id="<%= coupon._id %>" btn-copy></i>
                        </div>
                      </div>
                      <div class="content-font card-description">
                        <span>
                          <%= coupon.description %>
                        </span>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
              </li>
            <% }) %>
            <% } else { %>
              <li class="content-font d-flex align-items-center justify-content-center">
                <i class="bi bi-emoji-frown me-1"></i>
                Không có mã giảm giá
              </li>
            <% } %>
            </ul>
          </div>
        </div>
      </section>

      <section class="cart-list">
        <div class="container">
          <div class="row g-3">
            <%# Cart Table %>
            <div class="col-lg-9 col-md-8 col-12">
              <div class="overflow-x-scroll w-100 cart-table-wrapper">
                <table class="w-100 table cart-table">
                  <thead class="cart-head">
                    <tr class="text-uppercase cart-head-row cart-row row-title">
                      <th class="cart-head-cell cart-cell cell-title">Stt</th>
                      <th class="cart-head-cell cart-cell cell-title">Ảnh</th>
                      <th class="cart-head-cell cart-cell cell-title">Tên</th>
                      <th class="cart-head-cell cart-cell cell-title">Giá</th>
                      <th class="cart-head-cell cart-cell cell-title">Giảm</th>
                      <th class="cart-head-cell cart-cell cell-title">Số lượng</th>
                      <th class="cart-head-cell cart-cell cell-title">Tổng</th>
                      <th class="cart-head-cell cart-cell cell-title">Hành động</th>
                    </tr>
                  </thead>
                  <tbody class="content-font cart-body">
                    <% if(cart.products.length > 0) { %> <% cart.products.forEach((product, index)=>
                    { %>
                    <tr class="cart-body-row cart-row">
                      <td class="cart-body-cell cart-cell"><%= index + 1 %></td>
                      <td class="cart-body-cell cart-cell">
                        <a
                          href="/products/detail/<%= product.productInfo.slug %>"
                          class="cart-body-product-link"
                        >
                          <img
                            src="<%= product.productInfo.thumbnail %>"
                            alt="Ảnh sản phẩm"
                            width="60px"
                            class="cart-body-product-thumbnail"
                          />
                        </a>
                      </td>
                      <td class="w-25 cart-body-cell cart-cell">
                        <a
                          href="/products/detail/<%= product.productInfo.slug %>"
                          class="text-decoration-none text-dark text-wrap cart-body-product-link"
                        >
                          <%= product.productInfo.title %>
                        </a>
                      </td>
                      <td class="cart-body-cell cart-cell">
                        <%= new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND'
                        }).format(product.productInfo.price) %>
                      </td>
                      <td class="cart-body-cell cart-cell"><%= product.productInfo.discount %>%</td>
                      <td class="cart-body-cell cart-cell" style="width: 10%">
                        <input
                          type="number"
                          min="0"
                          class="input-type01 text-center w-100 cart-body-product-quantity"
                          product-id="<%= product.productInfo._id %>"
                          value="<%= product.quantity %>"
                        />
                      </td>
                      <td class="cart-body-cell cart-cell">
                        <div class="fw-bold text-warning cart-body-product-total">
                          <%= new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND'
                          }).format(Number.parseFloat(product.productInfo.newPrice *
                          product.quantity)) %>
                        </div>
                      </td>
                      <td class="cart-body-cell cart-cell">
                        <div class="d-flex flex-wrap gap-2 cart-body-product-action">
                          <button
                            class="button-icon-primary cart-body-product-remove cart-product-remove"
                            product-id="<%= product.productInfo._id %>"
                          >
                            <i class="bi bi-x-lg"></i>
                          </button>
                          <button
                            class="button-icon-primary cart-body-product-like btn-add-favorite"
                            data-id="<%= product.productInfo._id %>"
                          >
                            <i class="bi bi-heart-fill"></i>
                          </button>
                        </div>
                      </td>
                    </tr>
                    <% }) %> <% } else { %>
                    <tr>
                      <td colspan="8" class="text-center">
                        Ko có đơn hàng nào trong giỏ hàng. <a href="/products">Mua ngay</a>
                      </td>
                    </tr>
                    <%}%>
                  </tbody>
                </table>
                <% if (cart.products.length > 0) { %>
                <div class="d-flex justify-content-center my-3">
                  <%-include('../../partials/pagination.view.ejs', { objPagination: objPagination })
                  %>
                </div>
                <% } %>
              </div>
            </div>

            <%# Cart Form & Info %>
            <div class="col-lg-3 col-md-4 col-12">
              <div class="d-flex flex-column cart-info">
                <% if(cart.products.length > 0) { %>
                <div class="cart-coupon">
                  <h4 class="fw-bold title-font text-uppercase cart-coupon-heading">Mã giảm giá</h4>
                  <form method="POST" action="/cart/apply-coupon?_method=PATCH" class="d-flex flex-column gap-2 cart-coupon-form">
                    <input
                      name="couponCode"
                      type="text"
                      class="input-type01 cart-coupon-input"
                      placeholder="Nhập mã giảm giá..."
                    />
                    <% if (cart.coupon) { %>
                      <div class="d-flex flex-column gap-1">
                        <span class="badge w-100 cart-coupon-code-applied" style="background-color: var(--dark-gray-color);">
                          <i class="fa-solid fa-ticket-simple me-1"></i>Đang sử dụng: 
                        <span class="fw-bold"><%= cart.coupon.code %></span>
                        </span>
                        <span class="badge w-100 cart-coupon-code-applied" style="background-color: var(--dark-gray-color);">
                          <%= 'Giảm: ' + new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(cart.couponAmount) %>
                        </span>
                      </div>
                    <% } %>
                    <div class="d-flex gap-1 flex-wrap">
                      <button type="submit" class="button-primary flex-fill cart-coupon-btn-apply">
                        Áp dụng
                      </button>
                      <button type="button" class="button-primary flex-fill cart-coupon-btn-remove" card-coupon-remove>
                        Xóa
                      </button>
                    </div>
                    <button
                      type="button"
                      class="button-primary w-100 text-center text-decoration-none cart-coupon-btn-show"
                      card-coupon-show
                    >
                      Các mã giảm giá có thể sử dụng
                    </button>
                  </form>
                  <hr />
                </div>
                <% } %>

                <% if(cart.products.length > 0) { %>
                <div class="cart-coupon">
                  <h4 class="fw-bold title-font text-uppercase cart-total-heading">
                    Phí vận chuyển
                  </h4>
                  <div class="d-flex justify-content-between align-items-center cart-total-price">
                    <span class="cart-total-price-title"
                      >Cộng thêm:
                      <b
                        >+<%=new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND'
                        }).format(12000) %>
                      </b>
                    </span>
                  </div>
                  <hr />
                </div>
                <% } %>

                <div class="cart-total">
                  <h4 class="fw-bold title-font text-uppercase cart-total-heading">Tổng tiền</h4>
                  <div class="d-flex justify-content-between align-items-center cart-total-price">
                    <span class="cart-total-price-title">Tổng chi phí:</span>
                    <% if(cart.finalTotal) { %>
                      <span class="heading-font fw-bold text-danger py-0 cart-total-price-value">
                        <%= new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(cart.finalTotal) %>
                      </span>
                    <% } else { %>
                      <span class="heading-font fw-bold text-danger py-0 cart-total-price-value">
                        <% if (cart.total || cart.total === 0) { %> 
                          <%= new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(cart.total) %> 
                        <% } %>
                    </span>
                    <% } %>
                  </div>
                  <hr />
                </div>
                <% if(cart.products.length > 0) { %>
                <div class="cart-payment">
                  <a
                    href="/payment"
                    class="button-secondary w-100 d-block text-center text-decoration-none cart-payment-btn"
                  >
                    Tiến hành thanh toán
                  </a>
                </div>
                <% } %>
              </div>
            </div>
          </div>
        </div>
      </section>

      <% if(cart.products.length > 0) { %>
      <section class="pb-5 related-products">
        <h3 class="heading-font text-center related-products-title">Sản phẩm liên quan</h3>

        <div class="container">
          <div class="row justify-content-center g-2">
            <% if(relatedProductList.length === 0) { %><span class="content-font text-center"
              >(Không tìm thấy sản phẩm phù hợp)</span
            ><% } %> <% relatedProductList.forEach(product => { %>
            <div class="col-lg-2 col-md-4 col-6">
              <div class="card-bg" title="<%= product.title %>">
                <% if(product.discount > 0) { %>
                <div class="card-discount-badge">
                  <img src="/client/images/product/sale-badge/sale-badge (1).png" width="40px" />
                </div>
                <span class="content-font text-white card-discount-text"
                  >-<%= product.discount %>%</span
                >
                <% } %>
                <div class="card-image">
                  <img
                    src="<%= product.thumbnail %>"
                    alt="product"
                    width="100%"
                    class="card-thumbnail"
                  />
                  <div class="card-link">
                    <a
                      href="/products/detail/<%= product.slug %>"
                      class="content-font card-link-detail"
                    >
                      Xem chi tiết
                    </a>
                  </div>
                </div>
                <div class="content-font overflow-x-hidden text-nowrap card-title mt-1">
                  <% if(product.title.length > 25) { %> <%= product.title.slice(0, 25) + '...' %> <%
                  } else { %> <%= product.title %> <% } %>
                </div>
                <div class="card-box d-flex justify-content-between align-items-center">
                  <h5 class="title-font card-price">
                    <%= new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND'
                    }).format(Number.parseFloat(product.price - (product.price / 100 *
                    product.discount))) %>
                  </h5>
                  <div class="card-favorite <% if(product.isLike) { %>active<% } %>">
                    <button class="border-0 btn-add-favorite" data-id="<%= product.id %>">
                      <i class="bi bi-suit-heart-fill"></i>
                    </button>
                  </div>
                </div>
                <div class="content-font text-danger text-decoration-line-through">
                  Giá gốc: <%= new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND'
                  }).format(product.price) %>
                </div>
                <div class="card-rating d-flex justify-content-between align-items-center">
                  <div class="card-star">
                    <% for(let i = 1; i <= product.rating; i++) { %>
                    <i class="bi bi-star-fill"></i>
                    <% } %>
                  </div>
                  <form <% if(product.stock>
                    0) { %> action="/cart/add/<%= product.id %>" method="POST" <% } %>>
                    <button type="submit" class="border-0 bg-transparent">
                      <i title="add to cart" class="bi bi-bag-check-fill"></i>
                    </button>
                  </form>
                </div>
              </div>
            </div>
            <% }) %>
          </div>
        </div>
      </section>
      <% } %>
    </main>

    <%-include('../../partials/buttonMessage.view.ejs') %>
    <%-include('../../partials/buttonHotLine.view.ejs') %>
    <%-include('../../partials/buttonMailTo.view.ejs') %>
    <%-include('../../partials/buttonScrollToTop.view.ejs') %>
    <%-include('../../partials/buttonChatBot.view.ejs') %>
    <%-include('../../partials/footer.view.ejs') %>

    <form action="/cart/delete" method="POST" class="d-none form-delete-product-cart" id="form-delete-product-cart"></form>
    <form action="/cart/change-quantity" method="POST" class="d-none form-change-quantity-cart" id="form-change-quantity-cart"></form>
    <form action="/cart/remove-coupon" method="POST" class="d-none form-remove-coupon" id="form-remove-coupon"></form>
    <form action="/products/add-favorite" method="POST" class="d-none form-add-favorite" id="form-add-favorite"></form>

    <%# Scripts File %>
    <script src="/client/scripts/alertMessage.js"></script>
    <script src="/client/scripts/toggleHeaderMobile.js"></script>
    <script src="/client/scripts/scrollToTop.js"></script>
    <script src="/client/scripts/product/toggleSearchProduct.js"></script>
    <script src="/client/scripts/addProductLike.js"></script>
    <script src="/client/scripts/pagination.js"></script>
    <script src="/client/scripts/copyClipboard.js"></script>
    <script src="/client/scripts/cart/deleteProductInCart.js"></script>
    <script src="/client/scripts/cart/changeProductQuantity.js"></script>
    <script src="/client/scripts/cart/showCouponModal.js"></script>
    <script src="/client/scripts/cart/removeCoupon.js"></script>
    <%# End Scripts File %>

    <%# Scripts Library & Framework Link %>
    <%# Bootstrap %>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <%# FontAwesome %>
    <script src="https://kit.fontawesome.com/aaf479b433.js" crossorigin="anonymous"></script>
    <%# End Scripts Library & Framework Link %>

    <script src="/reload/reload.js"></script>
  </body>
</html>
