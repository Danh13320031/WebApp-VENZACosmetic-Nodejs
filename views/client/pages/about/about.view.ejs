<!DOCTYPE html>
<html lang="en">
  <head>
    <%-include('../../partials/seoMeta.view.ejs', { pageTitle: pageTitle}) %>

    <!-- Styles File -->
    <link rel="stylesheet" href="/client/setup.css" />
    <link rel="stylesheet" href="/client/styles/partials/alert.css" />
    <link rel="stylesheet" href="/client/styles/partials/header.css" />
    <link rel="stylesheet" href="/client/styles/pages/index/index.css" />
    <link rel="stylesheet" href="/client/styles/pages/index/index.responsive.css" />
    <link rel="stylesheet" href="/client/styles/partials/breadcrumb.css" />
    <link rel="stylesheet" href="/client/styles/partials/buttonMessage.css" />
    <link rel="stylesheet" href="/client/styles/partials/buttonHotLine.css" />
    <link rel="stylesheet" href="/client/styles/partials/buttonMailTo.css" />
    <link rel="stylesheet" href="/client/styles/partials/buttonScrollToTop.css" />
    <link rel="stylesheet" href="/client/styles/partials/buttonChatBot.css" />
    <link rel="stylesheet" href="/client/styles/partials/footer.css" />
    <!-- End Styles File -->

    <!-- Styles Library & Framework Link -->
    <!-- Bootstrap -->
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.5/dist/css/bootstrap.min.css"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
    />
    <!-- BoxIcon -->
    <link href="https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css" rel="stylesheet" />
    <!-- SlickSlide -->
    <link
      rel="stylesheet"
      type="text/css"
      href="//cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.css"
    />
    <!-- End Styles Library & Framework Link -->
  </head>
  <body>
    <%-include('../../partials/alertMessage.view.ejs') %>
    <%-include('../../partials/header.view.ejs', { categoryListTree: categoryTree, homeActive: "",
    aboutActive: 'active', productActive: '', newsActive: '', contactActive: '', cartActive: '' });
    %> <%-include("../../partials/headerMobile.view.ejs") %>

    <main class="main">
      <%-include('../../partials/breadcrumb.view.ejs', { pageTitle: pageTitle, pageUrl: pageUrl })%>

      <section class="about-general">
        <div class="container">
          <div class="row">
            <div class="col-12">
              <div
                class="d-flex flex-column justify-content-center w-100 h-100 gap-3 abount-detail-content-box"
              >
                <h5 class="title-font abount-detail-title">
                  1. <%= generalWebsite ? generalWebsite.name : '' %> - Về chúng tôi
                </h5>
                <p class="content-font text-justify about-general-paragraph">
                  <%= generalWebsite ? generalWebsite.shortIntro : '' %>
                </p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="about-detail">
        <div class="container">
          <div class="row d-flex gap-lg-0 gap-5">
            <div class="col-lg-6 col-12">
              <div
                class="d-flex flex-column justify-content-center w-100 h-100 gap-3 abount-detail-content-box"
              >
                <h5 class="title-font abount-detail-title">
                  2. <%= generalWebsite ? generalWebsite.name : '' %> - Câu chuyện thương hiệu
                </h5>
                <ul class="ps-0 d-flex flex-column gap-2 about-detail-list">
                  <li class="content-font abount-detail-item">
                    <p class="content-font mb-0 abount-detail-paragraph">
                      VENZA ra đời từ niềm tin rằng mọi phụ nữ đều xứng đáng được yêu thương và chăm
                      sóc làn da của mình một cách trọn vẹn nhất.
                    </p>
                  </li>
                  <li class="content-font abount-detail-item">
                    <p class="content-font mb-0 abount-detail-paragraph">
                      Chúng tôi hiểu rằng, trong cuộc sống hiện đại, làn da không chỉ phản ánh sức
                      khỏe mà còn là tấm gương thể hiện sự tự tin, phong thái và cá tính của mỗi
                      người.
                    </p>
                  </li>
                  <li class="content-font about-detail-item">
                    <p class="content-font mb-0 abount-detail-paragraph">
                      Khởi nguồn từ niềm đam mê với mỹ phẩm và cái đẹp, VENZA mang sứ mệnh kết nối
                      người Việt với những sản phẩm làm đẹp chất lượng, an toàn và hiệu quả, được
                      tuyển chọn kỹ lưỡng từ các thương hiệu uy tín trong và ngoài nước.
                    </p>
                  </li>
                </ul>
              </div>
            </div>
            <div class="col-lg-6 col-12">
              <div
                class="d-flex justify-content-center align-items-center w-100 h-100 about-detail-image-box"
              >
                <img
                  src="/client/images/about/about_detail_update (1).png"
                  alt="about-1"
                  width="80%"
                  class="abount-detail-image"
                />
              </div>
            </div>

            <div class="col-lg-6 col-12">
              <div
                class="d-flex justify-content-center align-items-center w-100 h-100 about-detail-image-box"
              >
                <img
                  src="/client/images/about/about_detail_update (3).png"
                  alt="about-1"
                  width="80%"
                  class="abount-detail-image"
                />
              </div>
            </div>
            <div class="col-lg-6 col-12">
              <div
                class="d-flex flex-column justify-content-center w-100 h-100 gap-3 abount-detail-content-box"
              >
                <h5 class="title-font abount-detail-title">
                  3. <%= generalWebsite ? generalWebsite.name : '' %> - Sứ mệnh & tầm nhìn
                </h5>
                <ul class="ps-0 d-flex flex-column gap-2 about-detail-list">
                  <li class="content-font abount-detail-item">
                    <p class="content-font mb-0 abount-detail-paragraph">
                      Tại VENZA, chúng tôi tin rằng vẻ đẹp đích thực đến từ sự thấu hiểu và chăm sóc
                      làn da đúng cách. Vì vậy, sứ mệnh của chúng tôi là đồng hành cùng khách hàng
                      trong hành trình khám phá vẻ đẹp tự nhiên của chính mình, thông qua các sản
                      phẩm và dịch vụ chuyên sâu về chăm sóc – trang điểm – dưỡng da.
                    </p>
                  </li>
                  <li class="content-font abount-detail-item">
                    <p class="content-font mb-0 abount-detail-paragraph">
                      VENZA luôn đặt sức khỏe làn da lên hàng đầu, đảm bảo rằng mỗi sản phẩm trước
                      khi đến tay khách hàng đều được kiểm định chất lượng kỹ càng, có nguồn gốc rõ
                      ràng và phù hợp với điều kiện khí hậu, cơ địa của người Việt.
                    </p>
                  </li>
                  <li class="content-font abount-detail-item">
                    <p class="content-font mb-0 abount-detail-paragraph">
                      VENZA hướng tới trở thành thương hiệu mỹ phẩm đáng tin cậy hàng đầu Việt Nam,
                      nơi khách hàng có thể tìm thấy mọi giải pháp làm đẹp toàn diện – từ dưỡng da,
                      chăm tóc, đến chăm sóc cơ thể. Chúng tôi mong muốn xây dựng một cộng đồng yêu
                      cái đẹp bền vững, nơi mọi người đều có thể chia sẻ, học hỏi và phát triển cùng
                      nhau.
                    </p>
                  </li>
                </ul>
              </div>
            </div>

            <div class="col-lg-6 col-12">
              <div
                class="d-flex flex-column justify-content-center w-100 h-100 gap-3 abount-detail-content-box"
              >
                <h5 class="title-font abount-detail-title">
                  4. <%= generalWebsite ? generalWebsite.name : '' %> - Giá trị cốt lõi
                </h5>
                <ul class="ps-0 d-flex flex-column gap-2 about-detail-list">
                  <li class="content-font abount-detail-item">
                    <p class="content-font mb-0 abount-detail-paragraph">
                      <b class="fw-bold">🌿 Chính hãng – Minh bạch:</b> Mỗi sản phẩm đều có chứng
                      nhận nguồn gốc rõ ràng, nhập khẩu chính ngạch, cam kết 100% hàng thật.
                    </p>
                  </li>
                  <li class="content-font abount-detail-item">
                    <p class="content-font mb-0 abount-detail-paragraph">
                      <b class="fw-bold">💧 Chất lượng – Hiệu quả:</b> VENZA lựa chọn sản phẩm có
                      công thức lành tính, hiệu quả cao, được chuyên gia da liễu khuyên dùng.
                    </p>
                  </li>
                  <li class="content-font abount-detail-item">
                    <p class="content-font mb-0 abount-detail-paragraph">
                      <b class="fw-bold">🤝 Tận tâm – Đồng hành:</b> Đội ngũ VENZA luôn lắng nghe và
                      tư vấn cá nhân hóa cho từng loại da, từng nhu cầu riêng biệt.
                    </p>
                  </li>
                  <li class="content-font abount-detail-item">
                    <p class="content-font mb-0 abount-detail-paragraph">
                      <b class="fw-bold">💖 Trách nhiệm – Uy tín:</b> Chúng tôi xem niềm tin của
                      khách hàng là nền tảng để phát triển bền vững.
                    </p>
                  </li>
                </ul>
              </div>
            </div>
            <div class="col-lg-6 col-12">
              <div
                class="d-flex justify-content-center align-items-center w-100 h-100 about-detail-image-box"
              >
                <img
                  src="/client/images/about/about_detail_update (2).png"
                  alt="about-1"
                  width="80%"
                  class="abount-detail-image"
                />
              </div>
            </div>

            <div class="col-lg-6 col-12">
              <div
                class="d-flex justify-content-center align-items-center w-100 h-100 about-detail-image-box"
              >
                <img
                  src="/client/images/about/about_detail_update (4).png"
                  alt="about-1"
                  width="80%"
                  class="abount-detail-image"
                />
              </div>
            </div>
            <div class="col-lg-6 col-12">
              <div
                class="d-flex flex-column justify-content-center w-100 h-100 gap-3 abount-detail-content-box"
              >
                <h5 class="title-font abount-detail-title">
                  5. <%= generalWebsite ? generalWebsite.name : '' %> - Dịch vụ & trải nghiệm
                </h5>
                <ul class="ps-0 d-flex flex-column gap-2 about-detail-list">
                  <li class="content-font abount-detail-item">
                    <p class="content-font mb-0 abount-detail-paragraph">
                      Tại VENZA, mỗi khách hàng đều được trân trọng như một người bạn đồng hành.
                      Chúng tôi xây dựng hệ thống bán hàng trực tuyến hiện đại, giao diện thân
                      thiện, giúp bạn dễ dàng tìm kiếm, so sánh và đặt mua sản phẩm chỉ trong vài
                      bước đơn giản.
                    </p>
                  </li>
                  <li class="content-font abount-detail-item">
                    <p class="content-font mb-0 abount-detail-paragraph">
                      Đội ngũ chăm sóc khách hàng của VENZA hoạt động 7 ngày/tuần, sẵn sàng tư vấn,
                      giải đáp mọi thắc mắc và hỗ trợ đổi trả linh hoạt khi cần thiết.
                    </p>
                  </li>
                  <li class="content-font abount-detail-item">
                    <p class="content-font mb-0 abount-detail-paragraph">
                      Từng đơn hàng, từng phản hồi của bạn đều là động lực để VENZA hoàn thiện hơn
                      mỗi ngày.
                    </p>
                  </li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="mt-4 about-commit">
        <div class="container">
          <div class="row">
            <div class="col-12">
              <div
                class="d-flex flex-column justify-content-center w-100 h-100 gap-3 abount-detail-content-box"
              >
                <h5 class="title-font abount-detail-title">
                  6. <%= generalWebsite ? generalWebsite.name : '' %> - Cam kết
                </h5>
                <ul
                  class="ps-0 d-flex flex-column gap-2 about-detail-list"
                  style="color: var(--error-color)"
                >
                  <li class="content-font abount-detail-item">
                    <p class="content-font mb-0 abount-detail-paragraph">
                      Chỉ cung cấp sản phẩm chính hãng 100%, có hóa đơn và chứng từ đầy đủ.
                    </p>
                  </li>
                  <li class="content-font abount-detail-item">
                    <p class="content-font mb-0 abount-detail-paragraph">
                      Không ngừng cập nhật xu hướng làm đẹp mới nhất trên thế giới.
                    </p>
                  </li>
                  <li class="content-font abount-detail-item">
                    <p class="content-font mb-0 abount-detail-paragraph">
                      Đảm bảo giá cả hợp lý, minh bạch và cạnh tranh.
                    </p>
                  </li>
                  <li class="content-font abount-detail-item">
                    <p class="content-font mb-0 abount-detail-paragraph">
                      Luôn đặt sự hài lòng của khách hàng lên trên mọi lợi ích kinh doanh.
                    </p>
                  </li>
                  <li class="content-font abount-detail-item">
                    <p class="content-font mb-0 abount-detail-paragraph">
                      Cam kết bảo mật thông tin cá nhân và mang lại trải nghiệm mua sắm an toàn –
                      tiện lợi – nhanh chóng.
                    </p>
                  </li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="mt-4 about-trip">
        <div class="container">
          <div class="row">
            <div class="col-12">
              <div
                class="d-flex flex-column justify-content-center w-100 h-100 gap-3 abount-detail-content-box"
              >
                <h5 class="title-font abount-detail-title">7. Hành trình sắp tới</h5>
                <img
                  src="/client/images/about/about_detail_5.png"
                  alt="about-1"
                  width="100%"
                  class="abount-detail-image"
                />
                <ul class="ps-0 d-flex flex-column gap-2 about-detail-list">
                  <li class="content-font abount-detail-item">
                    <p class="content-font mb-0 abount-detail-paragraph">
                      VENZA không chỉ dừng lại ở việc phân phối mỹ phẩm – chúng tôi mong muốn trở
                      thành người bạn đồng hành đáng tin cậy của mọi cô gái Việt trên hành trình tìm
                      kiếm phiên bản đẹp nhất của chính mình.
                    </p>
                  </li>
                  <li class="content-font abount-detail-item">
                    <p class="content-font mb-0 abount-detail-paragraph">
                      Trong tương lai, VENZA sẽ mở rộng hợp tác với nhiều thương hiệu quốc tế, phát
                      triển hệ thống cửa hàng trải nghiệm, và ra mắt dòng sản phẩm mang thương hiệu
                      riêng VENZA – kết tinh từ triết lý “vẻ đẹp thuần khiết từ thiên nhiên”.
                    </p>
                  </li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </section>
    </main>

    <%-include('../../partials/buttonMessage.view.ejs') %>
    <%-include('../../partials/buttonHotLine.view.ejs') %>
    <%-include('../../partials/buttonMailTo.view.ejs') %>
    <%-include('../../partials/buttonScrollToTop.view.ejs') %>
    <%-include('../../partials/buttonChatBot.view.ejs') %>
    <%-include('../../partials/footer.view.ejs') %>

    <form
      action="/cart/delete"
      method="POST"
      class="d-none form-delete-product-cart"
      id="form-delete-product-cart"
    ></form>

    <form
      action="/cart/change-quantity"
      method="POST"
      class="d-none form-change-quantity-cart"
      id="form-change-quantity-cart"
    ></form>

    <!-- Scripts File -->
    <script src="/client/scripts/alertMessage.js"></script>
    <script src="/client/scripts/toggleHeaderMobile.js"></script>
    <script src="/client/scripts/scrollToTop.js"></script>
    <script src="/client/scripts/product/toggleSearchProduct.js"></script>
    <script src="/client/scripts/cart/deleteProductInCart.js"></script>
    <script src="/client/scripts/cart/changeProductQuantity.js"></script>
    <!-- End Scripts File -->

    <!-- Scripts Library & Framework Link -->
    <!-- Bootstrap -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <!-- FontAwesome -->
    <script src="https://kit.fontawesome.com/aaf479b433.js" crossorigin="anonymous"></script>
    <!-- SlickSlide -->
    <script type="text/javascript" src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script
      type="text/javascript"
      src="//cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.min.js"
    ></script>
    <script type="text/javascript" src="/client/scripts/slickslide.js"></script>

    <!-- <script src="./scripts/googlemap.js"></script> -->
    <!-- End Scripts Library & Framework Link -->

    <script src="/reload/reload.js"></script>
  </body>
</html>
