    <div class="card-footer border-0 chatbot-input" style="background: var(--dark-gray-color);">
      <div class="d-flex align-items-center justify-content-between gap-2 chatbot-input-text">
        <textarea name="" id="" cols="30" rows="1" placeholder="Nhập tin nhắn..." class="textarea-type01 content-font rounded-5 p-2"></textarea>
        <i class="button-secondary rounded-5 p-2 fas fa-paper-plane"></i>
      </div>
    </div>
  </div>
  <div 
