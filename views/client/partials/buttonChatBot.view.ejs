      <i class="fas fa-times chatbot-header-close" id="chatbot-header-close" style="color: var(--light-gray-color)"></i>
    </div>
    <div class="card-body overflow-y-scroll chatbot-message-container">
      <ul class="ps-0 d-flex flex-column gap-2 chat-message-list">
        <li class="p-2 rounded-2 chat-message-item" style="background: var(--light-gray-color);">
          <div class="d-flex gap-2 align-items-center">
