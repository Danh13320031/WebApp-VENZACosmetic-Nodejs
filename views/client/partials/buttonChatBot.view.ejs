<button class="button-chatbot" id="button-chatbot">
  <div class="button-chatbot-icon">
    <img src="/client/images/chatbot.png" alt="chatbot" width="100%" />
  </div>
</button>

<div class="position-fixed chatbot-container" id="chatbot-container">
  <div class="card border-0 shadow chatbot">
