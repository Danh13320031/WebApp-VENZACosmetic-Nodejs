<!DOCTYPE html>
<html lang="en">
  <head>
    <%-include("../../partials/seoMeta.view.ejs", { pageTitle: pageTitle}) %> <%# Style Library &
    Framework %>
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
    />

    <%# Style File %>
    <link rel="stylesheet" href="/admin/setup.css" />
    <link rel="stylesheet" href="/admin/styles/partials/alert.css" />
    <link rel="stylesheet" href="/admin/styles/partials/header.css" />
    <link rel="stylesheet" href="/admin/styles/partials/sider.css" />
    <link rel="stylesheet" href="/admin/styles/partials/footer.css" />
    <link rel="stylesheet" href="/admin/styles/pages/product/product.css" />
  </head>
  <body>
    <%-include("../../partials/header.view.ejs") %>

    <div class="body">
      <%-include("../../partials/sider.view.ejs") %>
      <div class="main">
        <%-include("../../partials/alertMessage.view.ejs") %> <%
        if(roleAuth.permission.includes('product-update')) {%>
        <h1 class="heading-font text-primary py-0 text-start"><%= pageTitle %></h1>
        <form
          action="<%= prefixAdmin %>/posts/update/<%= post._id %>?_method=PATCH"
          method="POST"
          enctype="multipart/form-data"
          id="form-handle"
        >
          <div class="container-fluid">
            <div class="row">
              <div class="col-6">
                <div class="form-group mb-4">
                  <label for="title" class="fw-bold"
                    ><span class="text-danger"><b>*</b></span> Tiêu đề
                  </label>
                  <input
                    type="text"
                    name="title"
                    value="<%= post.title %>"
                    placeholder="Nhập tiêu đề..."
                    required
                    class="form-control"
                    id="title"
                  />
                </div>
              </div>

              <div class="col-6">
                <div class="form-group mb-4">
                  <label for="category" class="fw-bold"
                    ><span class="text-danger"><b>*</b></span>
                    Danh mục
                  </label>
                  <select name="category" id="category" class="form-control">
                    <option disabled selected>-- Chọn danh mục --</option>
                    <%# if(categoryList.length > 0) {%>
                    <%#-include("../../partials/selecttree.view.ejs", {categoryList, level: 1,
                    parent_id: ''}) %> <%# } %>
                  </select>
                </div>
              </div>

              <div class="col-12">
                <div class="form-group mb-4">
                  <label for="summary" class="fw-bold"
                    ><span class="text-danger"><b>*</b></span>
                    Mô tả ngắn
                  </label>
                  <textarea
                    name="summary"
                    placeholder="Nhập mô tả..."
                    class="form-control"
                    id="summary"
                  >
<%= post.summary %></textarea
                  >
                </div>
              </div>

              <div class="col-12">
                <div class="form-group mb-4">
                  <label for="content" class="fw-bold"
                    ><span class="text-danger"><b>*</b></span>
                    Nội dung
                  </label>
                  <textarea
                    name="content"
                    placeholder="Nhập nội dung..."
                    class="form-control"
                    style="height: 600px"
                    id="content"
                  >
<%= post.content %></textarea
                  >
                </div>
              </div>

              <div class="col-6">
                <div class="form-group mb-4">
                  <label for="position" class="fw-bold">Vị trí</label>
                  <input
                    type="number"
                    name="position"
                    value="<%= post.position %>"
                    min="1"
                    placeholder="Tự động tăng"
                    class="form-control"
                    id="position"
                  />
                </div>
              </div>

              <div class="col-6">
                <div class="form-group mb-4">
                  <label for="rating" class="fw-bold">
                    Đánh giá (Số <i class="bi bi-star-fill text-warning"></i>)
                  </label>
                  <input
                    type="number"
                    name="rating"
                    value="<%= post.rating %>"
                    min="0"
                    max="5"
                    step="1"
                    placeholder="Ví dụ: 5, 4, 3, 2, 1"
                    class="form-control"
                    id="rating"
                  />
                </div>
              </div>

              <div class="col-6">
                <div class="form-group mb-4">
                  <label for="postedAt" class="fw-bold"
                    ><span class="text-danger"><b>*</b></span>
                    Ngày và giờ đăng
                  </label>
                  <input
                    type="datetime-local"
                    name="postedAt"
                    <% if(post?.postedBy?.postedAt && moment().isAfter(moment(post.postedBy.postedAt))) { %>
                   readonly <% } %> class="form-control" value="<%= post?.postedBy?.postedAt ?
                  moment(post.postedBy.postedAt).tz(timezone).format('YYYY-MM-DDTHH:mm') :
                  moment().tz(timezone).format('YYYY-MM-DDTHH:mm')%>" />
                </div>
              </div>

              <div class="col-6">
                <div class="form-group mb-4">
                  <label for="author" class="fw-bold"
                    ><span class="text-danger"><b>*</b></span> Tác giả
                  </label>
                  <input
                    type="text"
                    name="author"
                    value="<%= post.author %>"
                    placeholder="Nhập tiêu đề..."
                    required
                    class="form-control"
                    id="author"
                  />
                </div>
              </div>

              <div class="col-12">
                <div class="form-group mb-4">
                  <div class="image-box">
                    <div class="mb-4 d-flex jutify-content-end w-100 image-delete-box">
                      <i class="bi bi-x-lg float-end mb-2 image-delete"></i>
                    </div>
                    <div class="d-flex justify-content-center image-upload-box">
                      <img
                        src="<%= post.thumbnail %>"
                        alt="Hiển thị hình ảnh bài viết"
                        class="image-upload"
                      />
                    </div>
                  </div>
                  <label for="thumbnail" class="fw-bold"
                    ><span class="text-danger"><b>*</b></span>
                    Ảnh chính (.png / .jpg)
                  </label>
                  <input
                    type="file"
                    name="thumbnail"
                    accept="image/*"
                    class="form-control"
                    id="thumbnail"
                    input-upload-image
                  />
                </div>
              </div>

              <div class="col-lg-6 col-md-6 col-6">
                <div class="form-group mb-4">
                  <label for="" class="fw-bold d-block"
                    ><span class="text-danger"><b>*</b></span> Trạng thái</label
                  >
                  <input type="radio" name="status" value="active" <% if(post.status === 'active')
                  {%> checked <% } %> class="form-check-input" id="status-active" />
                  <label for="status-active" class="me-4">Hoạt động</label>

                  <input type="radio" name="status" value="inactive" <% if(post.status ===
                  'inactive') {%> checked <% } %> class="form-check-input" id="status-inactive" />
                  <label for="status-inactive">Ngừng hoạt động</label>
                </div>
              </div>

              <div class="col-lg-6 col-md-6 col-6">
                <div class="form-group mb-4">
                  <label for="" class="fw-bold d-block"
                    ><span class="text-danger"><b>*</b></span>
                    Nổi bật
                  </label>
                  <input type="radio" name="featured" value="1" class="form-check-input"
                  id="featured1" <% if(post.featured=== '1') {%> checked <% } %> />
                  <label for="featured1" class="me-4">Có</label>
                  <input type="radio" name="featured" value="0" class="form-check-input"
                  id="featured0" <% if(post.featured === '0') {%> checked <% } %> />
                  <label for="featured0">Ko</label>
                </div>
              </div>
            </div>
            <button type="submit" class="btn btn-outline-primary w-100 form-create">
              <i class="bi bi-pencil-square me-1"></i>Cập nhật bài viết
            </button>
          </div>
        </form>
        <% } %>
      </div>
    </div>

    <%-include("../../partials/footer.view.ejs") %> <%# Script File %>
    <script src="/admin/scripts/sidebarToggle.js"></script>
    <script src="/admin/scripts/activeSidebarLink.js"></script>
    <script src="/admin/scripts/previewImage.js"></script>
    <script src="/admin/scripts/product/previewImageArray.js"></script>
    <script src="/admin/scripts/toggleAccountInfo.js"></script>

    <%# Script Library & Framwork %>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://kit.fontawesome.com/aaf479b433.js" crossorigin="anonymous"></script>
    <script src="/tinymce/tinymce.min.js"></script>
    <script src="/admin/scripts/tinymce.js"></script>
    <script src="../../reload/reload.js"></script>
  </body>
</html>
