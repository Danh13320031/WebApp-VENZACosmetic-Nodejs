<!DOCTYPE html>
<html lang="en">
  <head>
    <%-include("../../partials/seoMeta.view.ejs", { pageTitle: pageTitle}) %>

    <!-- Style Library & Framework -->
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
    />

    <!-- Style File -->
    <link rel="stylesheet" href="/admin/setup.css" />
    <link rel="stylesheet" href="/admin/styles/partials/alert.css" />
    <link rel="stylesheet" href="/admin/styles/partials/header.css" />
    <link rel="stylesheet" href="/admin/styles/partials/sider.css" />
    <link rel="stylesheet" href="/admin/styles/partials/footer.css" />
    <link rel="stylesheet" href="/admin/styles/pages/product/product.css" />
  </head>
  <body>
    <%-include("../../partials/header.view.ejs") %>

    <div class="body">
      <%-include("../../partials/sider.view.ejs") %>
      <div class="main">
        <%-include("../../partials/alertMessage.view.ejs") %> <%
        if(roleAuth.permission.includes('product-add')) {%>
        <h1 class="heading-font text-primary py-0 text-start"><%= pageTitle %></h1>
        <form
          action="<%= prefixAdmin %>/products/create"
          method="POST"
          enctype="multipart/form-data"
          id="form-handle"
        >
          <div class="container-fluid">
            <div class="row">
              <div class="col-6">
                <div class="form-group mb-4">
                  <label for="title" class="fw-bold"
                    ><span class="text-danger"><b>*</b></span> Tiêu đề
                  </label>
                  <input type="text" name="title" required class="form-control" id="title" />
                </div>
              </div>

              <div class="col-6">
                <div class="form-group mb-4">
                  <label for="category" class="fw-bold"
                    ><span class="text-danger"><b>*</b></span>
                    Danh mục
                  </label>
                  <%# <input type="text" name="parent_id" id="parent_id" class="form-control" /> %>
                  <select name="category" id="category" class="form-control">
                    <option disabled selected>-- Chọn danh mục --</option>
                    <% if(categoryList.length > 0) {%>
                    <%-include("../../partials/selecttree.view.ejs", {categoryList, level: 1,
                    parent_id: ''}) %> <% } %>
                  </select>
                </div>
              </div>

              <div class="col-12">
                <div class="form-group mb-4">
                  <label for="description" class="fw-bold">Mô tả ngắn</label>
                  <textarea name="description" class="form-control" id="description"></textarea>
                </div>
              </div>

              <div class="col-12">
                <div class="form-group mb-4">
                  <label for="detail" class="fw-bold"
                    ><span class="text-danger"><b>*</b></span>
                    Mô tả chi tiết
                  </label>
                  <textarea name="detail" class="form-control" id="detail"></textarea>
                </div>
              </div>

              <div class="col-6">
                <div class="form-group mb-4">
                  <label for="price" class="fw-bold"
                    ><span class="text-danger"><b>*</b></span>
                    Giá (đ)
                  </label>
                  <input
                    type="number"
                    value="0"
                    min="0"
                    step="0.01"
                    name="price"
                    placeholder="Ví dụ: 45.34, 5.5, 70.56,..."
                    required
                    class="form-control"
                    id="price"
                  />
                </div>
              </div>

              <div class="col-6">
                <div class="form-group mb-4">
                  <label for="discount" class="fw-bold">Giảm giá (%)</label>
                  <input
                    type="number"
                    value="0"
                    min="0"
                    step="0.01"
                    name="discount"
                    placeholder="Ví dụ: 10.3, 5.5, 7,..."
                    required
                    class="form-control"
                    id="discount"
                  />
                </div>
              </div>

              <div class="col-6">
                <div class="form-group mb-4">
                  <label for="discountExpiredAt" class="fw-bold">Ngày kết thúc giảm giá</label>
                  <input
                    type="date"
                    min="<%= moment(Date.now()).add(1, 'days').format('YYYY-MM-DD') %>"
                    name="discountExpiredAt"
                    class="form-control"
                    id="discountExpiredAt"
                  />
                </div>
              </div>

              <div class="col-6">
                <div class="form-group mb-4">
                  <label for="stock" class="fw-bold"
                    ><span class="text-danger"><b>*</b></span>
                    Số lượng
                  </label>
                  <input
                    type="number"
                    value="0"
                    min="0"
                    name="stock"
                    required
                    class="form-control"
                    id="stock"
                  />
                </div>
              </div>

              <div class="col-6">
                <div class="form-group mb-4">
                  <label for="position" class="fw-bold">Vị trí</label>
                  <input
                    type="number"
                    name="position"
                    min="1"
                    placeholder="Tự động tăng"
                    class="form-control"
                    id="position"
                  />
                </div>
              </div>

              <div class="col-6">
                <div class="form-group mb-4">
                  <label for="warranty" class="fw-bold">Bảo hành</label>
                  <input
                    type="text"
                    name="warranty"
                    placeholder="Ví dụ: 1 year, 1.5 months, 2 years, lifetime,..."
                    class="form-control"
                    id="warranty"
                  />
                </div>
              </div>

              <div class="col-6">
                <div class="form-group mb-4">
                  <label for="brand" class="fw-bold">Thương hiệu</label>
                  <input
                    type="text"
                    name="brand"
                    placeholder="Ví dụ: Chanel, La Roche-Posay,..."
                    class="form-control"
                    id="brand"
                  />
                </div>
              </div>

              <div class="col-6">
                <div class="form-group mb-4">
                  <label for="rating" class="fw-bold">
                    Đánh giá (Số <i class="bi bi-star-fill text-warning"></i>)
                  </label>
                  <input
                    type="number"
                    value="0"
                    min="0"
                    max="5"
                    step="1"
                    name="rating"
                    placeholder="Ví dụ: 5, 4, 3, 2, 1"
                    class="form-control"
                    id="rating"
                  />
                </div>
              </div>

              <div class="col-12">
                <div class="form-group mb-4">
                  <div class="image-box">
                    <div class="mb-4 d-flex jutify-content-end w-100 image-delete-box">
                      <i class="bi bi-x-lg float-end mb-2 image-delete"></i>
                    </div>
                    <div class="d-flex justify-content-center image-upload-box">
                      <img src="" alt="Hiển thị hình ảnh sản phẩm" class="image-upload" />
                    </div>
                  </div>
                  <label for="thumbnail" class="fw-bold"
                    ><span class="text-danger"><b>*</b></span>
                    Ảnh chính (.png / .jpg)
                  </label>
                  <input
                    type="file"
                    name="thumbnail"
                    accept="image/*"
                    required
                    class="form-control"
                    id="thumbnail"
                    input-upload-image
                  />
                </div>
              </div>

              <div class="col-12">
                <div class="form-group mb-4">
                  <label for="images" class="fw-bold"
                    ><span class="text-danger"><b>*</b></span>
                    Ảnh phụ (.png / .jpg)
                  </label>
                  <div class="image-box">
                    <ul
                      class="d-flex justify-content-center align-items-center ps-0 gap-2 flex-wrap image-box-list"
                    >
                      <% for(let i = 0; i < 4; i++) { %>
                      <li
                        class="d-flex flex-column justify-content-between gap-1 p-2 border image-box-item"
                      >
                        <div class="w-100 d-flex flex-column align-items-end">
                          <div class="image-box-item-close">
                            <i
                              class="bi bi-x-lg image-delete-array product-image-item"
                              data-order="<%= i %>"
                            ></i>
                          </div>
                          <img
                            src=""
                            alt="Hiển thị hình ảnh sản phẩm"
                            width="100%"
                            class="image-upload-array product-image-item-<%= i %>"
                          />
                        </div>
                        <div class="w-100 image-box-item-input">
                          <input
                            type="file"
                            name="images"
                            accept="image/*"
                            class="form-control product-image-item product-image-item-<%= i %>"
                            data-order="<%= i %>"
                            input-image-array
                          /><input
                            type="hidden"
                            name="oldImages"
                            value=""
                            class="input-hidden-array product-image-item-<%= i %>"
                          />
                        </div>
                      </li>
                      <% } %>
                    </ul>
                  </div>
                </div>
              </div>

              <div class="col-lg-6 col-md-6 col-12">
                <div class="form-group mb-4">
                  <label for="" class="fw-bold d-block"
                    ><span class="text-danger"><b>*</b></span>
                    Trạng thái
                  </label>
                  <input
                    type="radio"
                    name="status"
                    value="active"
                    checked
                    class="form-check-input"
                    id="status-active"
                  />
                  <label for="status-active" class="me-4">Hoạt động</label>
                  <input
                    type="radio"
                    name="status"
                    value="inactive"
                    class="form-check-input"
                    id="status-inactive"
                  />
                  <label for="status-inactive">Ngừng hoạt động</label>
                </div>
              </div>

              <div class="col-lg-6 col-md-6 col-6">
                <div class="form-group mb-4">
                  <label for="" class="fw-bold d-block"
                    ><span class="text-danger"><b>*</b></span>
                    Nổi bật
                  </label>
                  <input
                    type="radio"
                    name="featured"
                    value="1"
                    class="form-check-input"
                    id="featured1"
                  />
                  <label for="featured1" class="me-4">Có</label>
                  <input
                    type="radio"
                    name="featured"
                    value="0"
                    checked
                    class="form-check-input"
                    id="featured0"
                  />
                  <label for="featured0">Ko</label>
                </div>
              </div>
            </div>
            <button type="submit" class="btn btn-outline-primary w-100 form-create">
              <i class="bi bi-plus-lg me-1"></i>Thêm mới sản phẩm
            </button>
          </div>
        </form>
        <% } %>
      </div>
    </div>

    <%-include("../../partials/footer.view.ejs") %>

    <!-- Script File -->
    <script src="/admin/scripts/sidebarToggle.js"></script>
    <script src="/admin/scripts/activeSidebarLink.js"></script>
    <script src="/admin/scripts/previewImage.js"></script>
    <script src="/admin/scripts/product/previewImageArray.js"></script>
    <script src="/admin/scripts/toggleAccountInfo.js"></script>

    <!-- Script Library & Framwork -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://kit.fontawesome.com/aaf479b433.js" crossorigin="anonymous"></script>
    <script src="/tinymce/tinymce.min.js"></script>
    <script src="/admin/scripts/tinymce.js"></script>
    <script src="../../reload/reload.js"></script>
  </body>
</html>
