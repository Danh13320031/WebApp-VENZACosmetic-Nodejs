<!DOCTYPE html>
<html lang="en">
  <head>
    <%-include("../../partials/seoMeta.view.ejs", { pageTitle: pageTitle}) %> <%# Style Library &
    Framework %>
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
    />

    <%# Style File %>
    <link rel="stylesheet" href="/admin/setup.css" />
    <link rel="stylesheet" href="/admin/styles/partials/alert.css" />
    <link rel="stylesheet" href="/admin/styles/partials/header.css" />
    <link rel="stylesheet" href="/admin/styles/partials/sider.css" />
    <link rel="stylesheet" href="/admin/styles/partials/footer.css" />
  </head>
  <body>
    <%-include("../../partials/header.view.ejs") %>

    <div class="body">
      <%-include("../../partials/sider.view.ejs") %>
      <div class="main">
        <%-include("../../partials/alertMessage.view.ejs") %> <%
        if(roleAuth.permission.includes('product-brand-view')) { %>
        <div class="row gap-md-0 gap-2">
          <div class="col-xxl-4 col-xl-4 col-lg-4 col-md-4 col-sm-12 col-12">
            <h1 class="heading-font text-primary py-0 text-start"><%= pageTitle %></h1>
          </div>
          <div class="col-xxl-4 col-xl-4 col-lg-4 col-md-4 col-sm-12 col-12"></div>
          <div class="col-xxl-4 col-xl-4 col-lg-4 col-md-4 col-sm-12 col-12">
            <%-include("../../partials/search.view.ejs", { placeholder: "Nhập tên thương hiệu..."})
            %>
          </div>
        </div>

        <div class="card mb-3">
          <div class="title-font card-header">
            Danh sách thương hiệu đã bị xóa (trang hiện tại: <%= objPagination.currentPage %>)
          </div>
          <div class="card-body">
            <div class="container-fluid p-2 p-md-2">
              <div class="row gap-lg-0 gap-2 justify-content-between">
                <div class="col-lg-4 col-12">
                  <%-include("../../partials/changeMulti.view.ejs", { statusList: statusList, url:
                  'product-brands', type: 'product-brand' }) %>
                </div>
              </div>
            </div>

            <div class="container-fluid">
              <div class="row">
                <div class="col-12 overflow-x-scroll">
                  <% if (productBrandList.length == 0) {%>
                  <div class="text-center text-white bg-danger p-2">
                    Không tìm thấy thương hiệu nào
                  </div>
                  <% } %>
                  <table class="table table-hover table-sm">
                    <thead class="content-font">
                      <th class="bg-primary-subtle text-primary text-decoration-underline">
                        <input type="checkbox" name="checkall" class="me-5" />STT
                      </th>
                      <th class="bg-primary-subtle text-primary text-decoration-underline">
                        Hình ảnh
                      </th>
                      <th class="bg-primary-subtle text-primary text-decoration-underline">
                        Tên thương hiệu
                      </th>
                      <% if(roleAuth.permission.includes('product-brand-change-status')) { %>
                      <th class="bg-primary-subtle text-primary text-decoration-underline">
                        Trạng thái
                      </th>
                      <% } %>
                      <th class="bg-primary-subtle text-primary text-decoration-underline">
                        Vị trí
                      </th>
                      <% if(roleAuth.permission.includes('product-brand-update') ||
                      roleAuth.permission.includes('product-brand-sort-delete')) { %>
                      <th class="bg-primary-subtle text-primary text-decoration-underline">
                        Hành động
                      </th>
                      <% } %>
                    </thead>

                    <tbody class="content-font">
                      <% productBrandList.forEach((brand, index) => { %>
                      <tr title="<%= brand.title %>">
                        <td>
                          <input
                            type="checkbox"
                            name="checkid"
                            value="<%= brand._id %>"
                            class="me-5"
                          />
                          <%= index + 1 %>
                        </td>
                        <td>
                          <img
                            src="<%= brand.thumbnail %>"
                            alt="<%= brand.title %>"
                            width="100px"
                          />
                        </td>
                        <td><%= brand.title %></td>
                        <% if(roleAuth.permission.includes('product-brand-change-status')) { %>
                        <td>
                          <% if(brand.status === 'active') {%>
                          <a
                            href="javascript:;"
                            data-id="<%= brand._id %>"
                            data-status="active"
                            change-status
                            class="badge"
                            style="background: var(--success-color-admin)"
                          >
                            Hoạt động
                          </a>
                          <% } else {%>
                          <a
                            href="javascript:;"
                            data-id="<%= brand._id %>"
                            data-status="inactive"
                            change-status
                            class="badge"
                            style="background: var(--warning-color-admin)"
                          >
                            Ngừng hoạt động
                          </a>
                          <% } %>
                        </td>
                        <% } %>
                        <td><%= brand.position %></td>
                        <td>
                          <% if(roleAuth.permission.includes('product-brand-restore')) {%>
                          <button
                            class="btn btn-primary btn-sm mb-1 btn-restore"
                            data-id="<%= brand._id %>"
                          >
                            <i class="bi bi-arrow-clockwise me-1"></i>Khôi phục
                          </button>
                          <% } %> <% if(roleAuth.permission.includes('product-brand-hard-delete'))
                          {%>
                          <button
                            class="btn btn-danger btn-sm mb-1 ml-1 btn-delete"
                            data-id="<%= brand._id %>"
                          >
                            <i class="bi bi-trash3 me-1"></i>Xóa vĩnh viễn
                          </button>
                          <% } %>
                        </td>
                      </tr>
                      <% }); %>
                    </tbody>
                  </table>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="container-fluid">
          <div class="row">
            <div class="col-lg-9 col-md-9 col-12">
              <%-include("../../partials/pagination.view.ejs") %>
            </div>
          </div>
        </div>
        <% } %>
      </div>
    </div>

    <%-include("../../partials/footer.view.ejs") %>

    <form
      action="<%= prefixAdmin %>/product-brands"
      method="POST"
      class="d-none"
      form-restore
    ></form>
    <form
      action="<%= prefixAdmin %>/product-brands"
      method="POST"
      class="d-none"
      form-delete-hard
    ></form>

    <%# Script File %>
    <script src="/admin/scripts/showAlert.js"></script>
    <script src="/admin/scripts/sidebarToggle.js"></script>
    <script src="/admin/scripts/activeSidebarLink.js"></script>
    <script src="/admin/scripts/deleteGarbage.js"></script>
    <script src="/admin/scripts/restoreGarbage.js"></script>
    <script src="/admin/scripts/search.js"></script>
    <script src="/admin/scripts/pagination.js"></script>
    <script src="/admin/scripts/changeMulti.js"></script>
    <script src="/admin/scripts/toggleAccountInfo.js"></script>

    <%# Script Library & Framwork %>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://kit.fontawesome.com/aaf479b433.js" crossorigin="anonymous"></script>
    <script src="../reload/reload.js"></script>
  </body>
</html>
