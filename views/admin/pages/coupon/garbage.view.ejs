<!DOCTYPE html>
<html lang="en">
  <head>
    <%-include("../../partials/seoMeta.view.ejs", { pageTitle: pageTitle}) %> <%# Style Library &
    Framework %>
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
    />

    <%# Style File %>
    <link rel="stylesheet" href="/admin/setup.css" />
    <link rel="stylesheet" href="/admin/styles/partials/alert.css" />
    <link rel="stylesheet" href="/admin/styles/partials/header.css" />
    <link rel="stylesheet" href="/admin/styles/partials/sider.css" />
    <link rel="stylesheet" href="/admin/styles/partials/copyClipboard.css">
    <link rel="stylesheet" href="/admin/styles/partials/footer.css" />
  </head>
  <body>
    <%-include("../../partials/header.view.ejs") %>

    <div class="body">
      <%-include("../../partials/sider.view.ejs") %>

      <div class="main">
        <%-include("../../partials/alertMessage.view.ejs") %> <%
        if(roleAuth.permission.includes('coupon-view')) { %>

        <div class="row gap-md-0 gap-2 justify-content-between">
          <div class="col-lg-8 col-md-4 col-12">
            <h1 class="heading-font text-primary py-0 text-start"><%= pageTitle %></h1>
          </div>

          <div class="col-lg-4 col-md-6 col-12">
            <%-include("../../partials/search.view.ejs", { placeholder: "Nhập mã giảm giá..."}) %>
          </div>
        </div>

        <div class="card mb-3">
          <div class="title-font card-header">
            Danh sách (trang hiện tại: <%= objPagination.currentPage %>)
          </div>
          <div class="card-body">
            <div class="container-fluid p-2 p-md-2">
              <div class="row gap-md-0 gap-2">
                <div class="col-lg-4 col-12">
                  <%-include("../../partials/changeMulti.view.ejs", { statusList: statusList, url:
                  'coupons', type: 'coupon' }) %>
                </div>
              </div>
            </div>

            <div class="container-fluid w-100">
              <div class="row">
                <div class="col-12 overflow-x-scroll">
                  <% if (couponList.length == 0) {%>
                  <div class="text-center text-white bg-danger p-2">
                    Không tìm thấy mã giảm giá nào
                  </div>
                  <% } %>
                  <table class="table table-hover table-sm w-100">
                    <thead class="content-font">
                      <th class="bg-primary-subtle text-primary text-decoration-underline">
                        <input type="checkbox" name="checkall" class="me-5" />STT
                      </th>
                      <th class="bg-primary-subtle text-primary text-decoration-underline">
                        Mã giảm giá
                      </th>
                      <th class="bg-primary-subtle text-primary text-decoration-underline">Giảm</th>
                      <th class="bg-primary-subtle text-primary text-decoration-underline">
                        Áp dụng
                      </th>
                      <% if(roleAuth.permission.includes('coupon-change-status')) {%>
                      <th class="bg-primary-subtle text-primary text-decoration-underline">
                        Trạng thái
                      </th>
                      <% } %>
                      <th class="bg-primary-subtle text-primary text-decoration-underline">
                        Thời gian bắt đầu
                      </th>
                      <th class="bg-primary-subtle text-primary text-decoration-underline">
                        Thời gian kết thúc
                      </th>
                      <th class="bg-primary-subtle text-primary text-decoration-underline">
                        Hạn sử dụng
                      </th>
                      <th class="bg-primary-subtle text-primary text-decoration-underline">
                        Vị trí
                      </th>
                      <th class="bg-primary-subtle text-primary text-decoration-underline">
                        Hành động
                      </th>
                    </thead>

                    <tbody class="content-font">
                      <% couponList.forEach((coupon, index) => { %>
                      <tr>
                        <td>
                          <input
                            type="checkbox"
                            name="checkid"
                            value="<%= coupon._id %>"
                            class="me-5"
                          />
                          <%= index + 1 %>
                        </td>
                        <td>
                          <div class="d-flex align-items-center gap-1">
                            <i class="fa-regular fa-copy me-1 btn btn-light btn-copy" data-id="<%= coupon._id %>" btn-copy></i>
                            <div class="text-wrap fw-bold text-copy" data-id="<%= coupon._id %>" text-copy><%= coupon.code %></div>
                          </div>
                        </td>
                        <td>
                          <div class="fw-bold" style="color: var(--primary-color-admin)">
                            <% if(coupon.valueType === 'percent') { %> <%= coupon.value %>% <% }
                            else { %> <%= new Intl.NumberFormat('vi-VN', { style: 'currency',
                            currency: 'VND' }).format(coupon.value) %> <% } %>
                          </div>
                        </td>
                        <td>
                          Cho đơn hàng từ
                          <span class="fw-bold">
                            <%= new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND'
                            }).format(coupon.minAmount) %>
                          </span>
                        </td>
                        <% if(roleAuth.permission.includes('coupon-change-status')) {%>
                        <td>
                          <% if(coupon.status === 'active') {%>
                          <a
                            href="javascript:;"
                            data-id="<%= coupon._id %>"
                            data-status="active"
                            change-status
                            class="badge"
                            style="background: var(--success-color-admin)"
                          >
                            Hoạt động
                          </a>
                          <% } else {%>
                          <a
                            href="javascript:;"
                            data-id="<%= coupon._id %>"
                            data-status="inactive"
                            change-status
                            class="badge"
                            style="background: var(--warning-color-admin)"
                          >
                            Ngừng hoạt động
                          </a>
                          <% } %>
                        </td>
                        <% } %>
                        <td>
                          <i class="fa-solid fa-clock me-1"></i>
                          <%= moment(coupon.startedAt).tz(timezone).format('DD/MM/YYYY HH:mm') %>
                        </td>
                        <td>
                          <i class="fa-solid fa-clock me-1"></i>
                          <%= moment(coupon.endedAt).tz(timezone).format('DD/MM/YYYY HH:mm') %>
                        </td>
                        <td>
                          <% if (moment(Date.now()).tz(timezone).toDate() < moment(coupon.startedAt).tz(timezone).toDate() &&
                          !coupon.published) { %>
                          <span class="badge" style="background: var(--warning-color-admin)">
                            Chưa phát hành
                          </span>
                          <% } else if (moment(Date.now()).tz(timezone).toDate() > moment(coupon.endedAt).tz(timezone).toDate() &&
                          !coupon.published) { %>
                          <span class="badge" style="background: var(--error-color-admin)">
                            Đã hết hạn
                          </span>
                          <% } else { %>
                          <span class="badge" style="background: var(--success-color-admin)">
                            Đang sử dụng
                          </span>
                          <% } %>
                        </td>
                        <td><%= coupon.position %></td>
                        <td>
                          <% if(roleAuth.permission.includes("coupon-restore")) { %>
                          <button
                            class="btn btn-primary btn-sm mb-1 btn-restore"
                            data-id="<%= coupon._id %>"
                          >
                            <i class="bi bi-arrow-clockwise me-1"></i>Khôi phục
                          </button>
                          <% } %> <% if(roleAuth.permission.includes("coupon-hard-delete")) { %>
                          <button
                            class="btn btn-danger btn-sm mb-1 ml-1 btn-delete"
                            data-id="<%= coupon._id %>"
                          >
                            <i class="bi bi-trash3 me-1"></i>Xóa vĩnh viễn
                          </button>
                          <% } %>
                        </td>
                      </tr>
                      <% }); %>
                    </tbody>
                  </table>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="container-fluid">
          <div class="row">
            <div class="col-lg-9 col-md-9 col-12">
              <%-include("../../partials/pagination.view.ejs") %>
            </div>
            <div class="col-lg-3 col-md-3 col-12">
              <a href="<%= prefixAdmin %>/coupons/garbage" class="btn btn-primary w-100 float-end"
                ><i class="bi bi-trash me-2"></i>Thùng rác
              </a>
            </div>
          </div>
        </div>
        <% } %>
      </div>
    </div>

    <%-include("../../partials/footer.view.ejs") %>

    <form
      action="<%= prefixAdmin %>/coupons"
      method="POST"
      class="d-none"
      form-restore
    ></form>

    <form
      action="<%= prefixAdmin %>/coupons"
      method="POST"
      class="d-none"
      form-delete-hard
    ></form>

    <%# Script File %>
    <script src="/admin/scripts/sidebarToggle.js"></script>
    <script src="/admin/scripts/activeSidebarLink.js"></script>
    <script src="/admin/scripts/search.js"></script>
    <script src="/admin/scripts/pagination.js"></script>
    <script src="/admin/scripts/deleteGarbage.js"></script>
    <script src="/admin/scripts/restoreGarbage.js"></script>
    <script src="/admin/scripts/changeMulti.js"></script>
    <script src="/admin/scripts/copyClipboard.js"></script>
    <script src="/admin/scripts/showAlert.js"></script>
    <script src="/admin/scripts/toggleAccountInfo.js"></script>

    <%# Script Library & Framwork %>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://kit.fontawesome.com/aaf479b433.js" crossorigin="anonymous"></script>
    <script src="../reload/reload.js"></script>
  </body>
</html>
