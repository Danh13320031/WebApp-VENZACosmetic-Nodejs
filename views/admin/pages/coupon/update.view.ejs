<!DOCTYPE html>
<html lang="en">
  <head>
    <%-include("../../partials/seoMeta.view.ejs", { pageTitle: pageTitle}) %> <%# Style Library &
    Framework %>
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
    />

    <%# Style File %>
    <link rel="stylesheet" href="/admin/setup.css" />
    <link rel="stylesheet" href="/admin/styles/partials/alert.css" />
    <link rel="stylesheet" href="/admin/styles/partials/header.css" />
    <link rel="stylesheet" href="/admin/styles/partials/sider.css" />
    <link rel="stylesheet" href="/admin/styles/partials/footer.css" />
    <link rel="stylesheet" href="/admin/styles/pages/product/product.css" />
  </head>
  <body>
    <%-include("../../partials/header.view.ejs") %>

    <div class="body">
      <%-include("../../partials/sider.view.ejs") %>
      <div class="main">
        <%-include("../../partials/alertMessage.view.ejs") %> <%
        if(roleAuth.permission.includes('product-add')) {%>
        <h1 class="heading-font text-primary py-0 text-start"><%= pageTitle %></h1>
        <form
          action="<%= prefixAdmin %>/coupons/update/<%= coupon._id %>?_method=PATCH"
          method="POST"
          id="form-handle"
        >
          <div class="container-fluid">
            <div class="row">
              <div class="col-lg-3 col-md-6 col-12">
                <div class="form-group mb-4">
                  <label for="code" class="fw-bold"
                    ><span class="text-danger"><b>*</b></span>
                    Mã giảm giá
                  </label>
                  <input
                    type="text"
                    value="<%= coupon.code %>"
                    name="code"
                    placeholder="Nhập mã giảm giá..."
                    required
                    readonly
                    disabled
                    class="form-control"
                    id="code"
                  />
                </div>
              </div>

              <div class="col-lg-3 col-md-6 col-12">
                <div class="form-group mb-4">
                  <label for="value" class="fw-bold"
                    ><span class="text-danger"><b>*</b></span>
                    Giá trị (vnđ / %)
                  </label>
                  <input
                    type="number"
                    value="<%= coupon.value %>"
                    min="0"
                    step="0.01"
                    name="value"
                    placeholder="Nhập giá trị mã giảm giá..."
                    required
                    class="form-control"
                    id="value"
                  />
                </div>
              </div>

              <div class="col-lg-3 col-md-6 col-12">
                <div class="form-group mb-4">
                  <label for="minAmount" class="fw-bold"
                    ><span class="text-danger"><b>*</b></span>
                    Cho đơn hàng từ
                  </label>
                  <input
                    type="number"
                    name="minAmount"
                    min="0"
                    value="<%= coupon.minAmount %>"
                    placeholder="Nhập tổng tiền thấp nhất..."
                    class="form-control"
                    id="minAmount"
                  />
                </div>
              </div>

              <div class="col-lg-3 col-md-6 col-12">
                <div class="form-group mb-4">
                  <label for="position" class="fw-bold"
                    ><span class="text-danger"><b>*</b></span>
                    Vị trí
                  </label>
                  <input
                    type="number"
                    name="position"
                    min="1"
                    value="<%= coupon.position %>"
                    placeholder="Tự động tăng"
                    class="form-control"
                    id="position"
                  />
                </div>
              </div>

              <div class="col-lg-4 col-md-4 col-12">
                <div class="form-group mb-4">
                  <label for="" class="fw-bold d-block"
                    ><span class="text-danger"><b>*</b></span>
                    Trạng thái
                  </label>
                  <input 
                    type="radio" 
                    name="status" 
                    value="active" 
                    <% if(coupon.status === 'active') { %> checked <% } %> 
                    class="form-check-input" 
                    id="status-active" 
                  />
                  <label for="status-active" class="me-4">Hoạt động</label>
                  <input 
                    type="radio" 
                    name="status" 
                    value="inactive" 
                    <% if(coupon.status === 'inactive') {%> checked <% } %> 
                    class="form-check-input" 
                    id="status-inactive" 
                  />
                  <label for="status-inactive">Ngừng hoạt động</label>
                </div>
              </div>

              <div class="col-lg-4 col-md-4 col-12">
                <div class="form-group mb-4">
                  <label for="" class="fw-bold d-block"
                    ><span class="text-danger"><b>*</b></span>
                    Phân loại giá trị
                  </label>
                  <input 
                    type="radio" 
                    name="valueType" 
                    value="amount" 
                    <% if(coupon.valueType === 'amount') {%> checked <% } %> 
                    class="form-check-input" 
                    id="valueType-amount"
                    input-check-show 
                  />
                  <label for="valueType-amount" class="me-4">Giảm theo tiền</label>
                  <input 
                    type="radio" 
                    name="valueType" 
                    value="percent" 
                    <% if(coupon.valueType === 'percent') {%> checked <% } %> 
                    class="form-check-input" 
                    id="valueType-percent"
                    input-check-show 
                  />
                  <label for="valueType-percent">Giảm theo %</label>
                </div>
              </div>

              <div class="col-lg-4 col-md-4 col-12">
                <div class="form-group mb-4">
                  <label for="" class="fw-bold d-block"
                    ><span class="text-danger"><b>*</b></span>
                    Phạm vi giảm giá
                  </label>
                  <input 
                    type="radio" 
                    name="scope" value="all" <% if(coupon.scope === 'all') {%>
                    checked <% } %> 
                    class="form-check-input" id="scope-all" 
                    input-check-show 
                  />
                  <label for="scope-all" class="me-4">Tất cả</label>
                  <input 
                    type="radio" 
                    name="scope" 
                    value="product" 
                    <% if(coupon.scope === 'product') { %> checked <% } %> 
                    class="form-check-input" 
                    id="scope-product" 
                    input-check-show
                  />
                  <label for="scope-product" class="me-4">Sản phẩm</label>
                  <input 
                    type="radio" 
                    name="scope" 
                    value="brand" 
                    <% if(coupon.scope === 'brand') {%> checked <% } %> 
                    class="form-check-input" 
                    id="scope-brand" 
                    input-check-show 
                  />
                  <label for="scope-brand">Thương hiệu</label>
                </div>
              </div>

              <% if(coupon.valueType === 'percent') { %>
              <div class="col-lg-4 col-md-6 col-12">
                <div class="form-group mb-4">
                  <label
                    for="maxDiscountAmount"
                    class="fw-bold <% if(coupon.valueType === 'amount') { %> d-none <% }%>"
                    ><span class="text-danger"><b>*</b></span>
                    Giá tối đa khi áp dụng giảm theo % (vnđ)
                  </label>
                  <input 
                    type="number" 
                    value="<%= coupon.maxDiscountAmount %>" 
                    min="0"
                    name="maxDiscountAmount" 
                    placeholder="Nhập giá tối đa khi áp dụng %..." 
                    required
                    <% if(coupon.valueType === 'amount') { %> disabled <% }%> 
                    class="form-control <% if(coupon.valueType === 'amount') { %> d-none <% }%>" 
                    id="maxDiscountAmount" />
                </div>
              </div>
              <% } %>

              <div class="col-lg-4 col-md-6 col-12">
                <div class="form-group mb-4">
                  <label for="productIds" class="fw-bold <% if(coupon.scope !== 'product') { %> d-none <% }%>"
                    ><span class="text-danger"><b>*</b></span> Sản phẩm (Ctrl + Click)
                  </label>
                  <select
                    name="productIds"
                    multiple
                    aria-label="multiple select example"
                    <% if(coupon.scope !== 'product') { %> disabled <% }%>
                    id="productIds"
                    class="form-control <% if(coupon.scope !== 'product') { %> d-none <% }%>"
                    style="height: 200px"
                  >
                    <option value="" disabled selected>-- Chọn các sản phẩm --</option>
                    <% productList.forEach(product => { %>
                      <option value="<%= product._id %>" <% if(product.checked) { %> selected <% } %> ><%= product.title %></option>
                    <% }) %>
                  </select>
                </div>
              </div>

              <div class="col-lg-4 col-md-6 col-12">
                <div class="form-group mb-4">
                  <label for="brandIds" class="fw-bold <% if(coupon.scope !== 'brand') { %> d-none <% }%>"
                    ><span class="text-danger"><b>*</b></span> Thương hiệu (Ctrl + Click)
                  </label>
                  <select
                    name="brandIds"
                    multiple
                    aria-label="multiple select example"
                    <% if(coupon.scope !== 'brand') { %> disabled <% }%>
                    id="brandIds"
                    class="form-control <% if(coupon.scope !== 'brand') { %> d-none <% }%>"
                    style="height: 200px"
                  >
                    <option value="" disabled selected>-- Chọn các thương hiệu --</option>
                    <% productBrandList.forEach(brand => { %>
                    <option value="<%= brand._id %>" <% if(brand.checked) { %> selected <% } %> ><%= brand.title %></option>
                    <% }) %>
                  </select>
                </div>
              </div>

              <div class="col-12">
                <div class="form-group mb-4">
                  <label for="description" class="fw-bold"
                    ><span class="text-danger"><b>*</b></span>
                    Mô tả ngắn
                  </label>
                  <textarea
                    name="description"
                    placeholder="Nhập mô tả..."
                    class="form-control"
                    id="description"
                  ><%= coupon.description %></textarea>
                </div>
              </div>

              <div class="col-6">
                <div class="form-group mb-4">
                  <label for="limit" class="fw-bold">Giới hạn số lượng</label>
                  <input
                    type="number"
                    name="limit"
                    min="1"
                    value="<%= coupon.limit %>"
                    placeholder="Nhập số lượng..."
                    class="form-control"
                    id="limit"
                  />
                </div>
              </div>

              <div class="col-6">
                <div class="form-group mb-4">
                  <label for="limitPerUser" class="fw-bold">Giới hạn dùng</label>
                  <input
                    type="number"
                    name="limitPerUser"
                    min="1"
                    value="<%= coupon.limitPerUser %>"
                    placeholder="Nhập số lần sử dụng..."
                    class="form-control"
                    id="limitPerUser"
                  />
                </div>
              </div>

              <div class="col-6">
                <div class="form-group mb-4">
                  <label for="startedAt" class="fw-bold">Thời gian bắt đầu giảm giá</label>
                  <input
                    type="datetime-local"
                    name="startedAt"
                    class="form-control"
                    id="startedAt"
                  />
                </div>
              </div>

              <div class="col-6">
                <div class="form-group mb-4">
                  <label for="endedAt" class="fw-bold">Thời gian kết thúc giảm giá</label>
                  <input type="datetime-local" name="endedAt" class="form-control" id="endedAt" />
                </div>
              </div>
            </div>
            <button type="submit" class="btn btn-outline-primary w-100 form-create">
              <i class="bi bi-plus-lg me-1"></i>Cập nhật mã giảm giá
            </button>
          </div>
        </form>
        <% } %>
      </div>
    </div>

    <%-include("../../partials/footer.view.ejs") %> <%# Script File %>
    <script src="/admin/scripts/sidebarToggle.js"></script>
    <script src="/admin/scripts/activeSidebarLink.js"></script>
    <script src="/admin/scripts/coupon/displayField.js"></script>
    <script src="/admin/scripts/toggleAccountInfo.js"></script>

    <%# Script Library & Framwork %>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://kit.fontawesome.com/aaf479b433.js" crossorigin="anonymous"></script>
    <script src="/tinymce/tinymce.min.js"></script>
    <script src="/admin/scripts/tinymce.js"></script>
    <script src="../../reload/reload.js"></script>
  </body>
</html>
