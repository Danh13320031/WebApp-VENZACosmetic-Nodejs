<!DOCTYPE html>
<html lang="en">
  <head>
    <%-include("../../partials/seoMeta.view.ejs", { pageTitle: pageTitle}) %> <%# Style Library &
    Framework %>
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
    />

    <%# Style File %>
    <link rel="stylesheet" href="/admin/setup.css" />
    <link rel="stylesheet" href="/admin/styles/partials/alert.css" />
    <link rel="stylesheet" href="/admin/styles/partials/header.css" />
    <link rel="stylesheet" href="/admin/styles/partials/sider.css" />
    <link rel="stylesheet" href="/admin/styles/partials/footer.css" />
  </head>
  <body>
    <%-include("../../partials/header.view.ejs") %>

    <div class="body">
      <%-include("../../partials/sider.view.ejs") %>

      <div class="main">
        <%#-include("../../partials/alertMessage.view.ejs") %> <%#
        if(roleAuth.permission.includes('coupon-view')) { %>

        <div class="row gap-md-0 gap-2 justify-content-between">
          <div class="col-lg-8 col-md-4 col-12">
            <h1 class="heading-font text-primary py-0 text-start"><%= pageTitle %></h1>
          </div>

          <div class="col-lg-4 col-md-6 col-12">
            <%#-include("../../partials/search.view.ejs", { placeholder: "Nhập tên sản phẩm..."}) %>
          </div>
        </div>

        <div class="card mb-3">
          <div class="title-font card-header">Bộ lọc</div>
          <div class="card-body">
            <div class="container-fluid">
              <div class="row gap-md-0 gap-2">
                <div class="col-xxl-3 col-xl-3 col-lg-3 col-md-3 col-sm-12 col-12">
                  <%#-include("../../partials/statusFilter.view.ejs") %>
                </div>
                <div class="col-xxl-5 col-xl-5 col-lg-5 col-md-5 col-sm-12 col-12">
                  <%#-include("../../partials/categoryFilter.view.ejs") %>
                </div>
                <div class="col-xxl-4 col-xl-4 col-lg-4 col-md-4 col-sm-12 col-12">
                  <%#-include("../../partials/priceFilter.view.ejs") %>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="card mb-3">
          <div class="title-font card-header">
            Danh sách (trang hiện tại: <%#= objPagination.currentPage %>)
          </div>
          <div class="card-body">
            <div class="container-fluid p-2 p-md-2">
              <div class="row gap-md-0 gap-2">
                <div class="col-lg-4 col-12">
                  <%#-include("../../partials/changeMulti.view.ejs", { statusList: statusList, url:
                  'products', type: 'product' }) %>
                </div>
                <div class="col-lg-4 col-12">
                  <%#-include("../../partials/sort.view.ejs", {sortOption: ['position-asc',
                  'position-desc', 'price-asc', 'price-desc', 'title-asc', 'title-desc']}) %>
                </div>
                <div class="col-lg-4 col-12">
                  <%# if(roleAuth.permission.includes('coupon-add')) {%>
                  <a
                    href="<%= prefixAdmin %>/coupons/create"
                    class="btn btn-primary w-100 float-end"
                  >
                    <i class="bi bi-plus-lg me-1"></i>Thêm mới mã giảm giá
                  </a>
                  <%# } %>
                </div>
              </div>
            </div>

            <div class="container-fluid w-100">
              <div class="row">
                <div class="col-12 overflow-x-scroll">
                  <% if (couponList.length == 0) {%>
                  <div class="text-center text-white bg-danger p-2">
                    Không tìm thấy sản phẩm nào trong kho
                  </div>
                  <% } %>
                  <table class="table table-hover table-sm w-100">
                    <thead class="content-font">
                      <th class="bg-primary-subtle text-primary text-decoration-underline">
                        <input type="checkbox" name="checkall" class="me-5" />STT
                      </th>
                      <th class="bg-primary-subtle text-primary text-decoration-underline">
                        Mã giảm giá
                      </th>
                      <th class="bg-primary-subtle text-primary text-decoration-underline">Giảm</th>
                      <th class="bg-primary-subtle text-primary text-decoration-underline">
                        Áp dụng
                      </th>
                      <%# if(roleAuth.permission.includes('coupon-change-status')) {%>
                      <th class="bg-primary-subtle text-primary text-decoration-underline">
                        Trạng thái
                      </th>
                      <%# } %>
                      <th class="bg-primary-subtle text-primary text-decoration-underline">
                        Thời gian bắt đầu
                      </th>
                      <th class="bg-primary-subtle text-primary text-decoration-underline">
                        Thời gian kết thúc
                      </th>
                      <th class="bg-primary-subtle text-primary text-decoration-underline">
                        Hạn sử dụng
                      </th>
                      <th class="bg-primary-subtle text-primary text-decoration-underline">
                        Phạm vi sử dụng
                      </th>
                      <th class="bg-primary-subtle text-primary text-decoration-underline">
                        Vị trí
                      </th>
                      <th class="bg-primary-subtle text-primary text-decoration-underline">
                        Hành động
                      </th>
                    </thead>

                    <tbody class="content-font">
                      <% couponList.forEach((coupon, index) => { %>
                      <tr>
                        <td>
                          <input
                            type="checkbox"
                            name="checkid"
                            value="<%= coupon._id %>"
                            class="me-5"
                          />
                          <%= index + 1 %>
                        </td>
                        <td>
                          <div class="text-wrap fw-bold"><%= coupon.code %></div>
                        </td>
                        <td>
                          <div class="fw-bold" style="color: var(--primary-color-admin)">
                            <% if(coupon.valueType === 'percent') { %> <%= coupon.value %>% <% }
                            else { %> <%= new Intl.NumberFormat('vi-VN', { style: 'currency',
                            currency: 'VND' }).format(coupon.value) %> <% } %>
                          </div>
                        </td>
                        <td>
                          Cho đơn hàng từ
                          <span class="fw-bold">
                            <%= new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND'
                            }).format(coupon.minAmount) %>
                          </span>
                        </td>
                        <%# if(roleAuth.permission.includes('coupon-change-status')) {%>
                        <td>
                          <% if(coupon.status === 'active') {%>
                          <a
                            href="javascript:;"
                            data-id="<%#= coupon._id %>"
                            data-status="active"
                            change-status
                            class="badge"
                            style="background: var(--success-color-admin)"
                          >
                            Hoạt động
                          </a>
                          <% } else {%>
                          <a
                            href="javascript:;"
                            data-id="<%= coupon._id %>"
                            data-status="inactive"
                            change-status
                            class="badge"
                            style="background: var(--warning-color-admin)"
                          >
                            Ngừng hoạt động
                          </a>
                          <% } %>
                        </td>
                        <%# } %>
                        <td>
                          <i class="fa-solid fa-clock me-1"></i>
                          <%= moment(coupon.startedAt).tz(timezone).format('DD/MM/YYYY HH:mm') %>
                        </td>
                        <td>
                          <i class="fa-solid fa-clock me-1"></i>
                          <%= moment(coupon.endedAt).tz(timezone).format('DD/MM/YYYY HH:mm') %>
                        </td>
                        <td>
                          <% if (moment(Date.now()).tz(timezone).toDate() < moment(coupon.startedAt).tz(timezone).toDate() &&
                          !coupon.published) { %>
                          <span class="badge" style="background: var(--warning-color-admin)">
                            Chưa phát hành
                          </span>
                          <% } else if (moment(Date.now()).tz(timezone).toDate() > moment(coupon.endedAt).tz(timezone).toDate() &&
                          !coupon.published) { %>
                          <span class="badge" style="background: var(--error-color-admin)">
                            Đã hết hạn
                          </span>
                          <% } else { %>
                          <span class="badge" style="background: var(--success-color-admin)">
                            Đang sử dụng
                          </span>
                          <% } %>
                        </td>
                        <td>
                          <div class="d-flex align-items-center gap-2">
                            <select
                              name="publishType"
                              id="status"
                              data-id="<%= coupon._id %>"
                              change-status-select
                              class="badge p-2 form-control"
                              <% if (coupon.publishType === 'all') { %>
                                style="color: var(--warning-color-admin); border-color: var(--warning-color-admin)"
                              <% } else if (coupon.publishType === 'user') { %>
                                style="color: var(--success-color-admin); border-color: var(--success-color-admin)"
                              <% } else if (coupon.publishType === 'guest') { %>
                                style="color: var(--info-color-admin); border-color: var(--info-color-admin)"
                              <% } %>
                              value="<%= coupon.publishType %>"
                            >
                              <option
                                <% if (coupon.publishType === 'all') { %> selected <% } %>
                                value="all"
                                class="text-light"
                                style="background: var(--warning-color-admin)"
                              >
                                Tất cả
                              </option>
                              <option
                                <% if (coupon.publishType === 'user') { %> selected <% } %>
                                value="user"
                                class="text-light"
                                style="background: var(--success-color-admin)"
                              >
                                Người dùng
                              </option>
                              <option
                                <% if (coupon.publishType === 'guest') { %> selected <% } %>
                                value="guest"
                                class="text-light"
                                style="background: var(--info-color-admin)"
                              >
                                Khách hàng
                              </option>
                            </select>
                          </div>
                        </td>
                        <td><%= coupon.position %></td>
                        <td>
                          <%# if(roleAuth.permission.includes('coupon-update')) {%>
                          <a
                            href="<%= prefixAdmin %>/coupons/update/<%= coupon._id %>"
                            data-id="<%= coupon._id %>"
                            class="btn btn-primary btn-sm mb-1 btn-update"
                          >
                            <i class="bi bi-pencil-square me-1"></i>Sửa
                          </a>
                          <%# } %>
                          <%#--------------------------------------------------------------------------------%>
                          <%# if(roleAuth.permission.includes('coupon-sort-delete')) {%>
                          <button
                            class="btn btn-danger btn-sm mb-1 ml-1 btn-delete"
                            data-id="<%= coupon._id %>"
                          >
                            <i class="bi bi-trash3 me-1"></i>Xóa
                          </button>
                          <%# } %>
                          <%#--------------------------------------------------------------------------------%>
                          <%# if(roleAuth.permission.includes('coupon-view')) {%>
                          <a
                            href="<%= prefixAdmin %>/products/detail/<%= coupon._id %>"
                            class="btn btn-outline-black text-black border-black btn-sm mb-1 ml-1 btn-detail"
                          >
                            Chi tiết<i class="bi bi-arrow-right-short ml-1"></i>
                          </a>
                          <%# } %>
                        </td>
                      </tr>
                      <% }); %>
                    </tbody>
                  </table>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="container-fluid">
          <div class="row">
            <div class="col-lg-9 col-md-9 col-12">
              <%#-include("../../partials/pagination.view.ejs") %>
            </div>
            <div class="col-lg-3 col-md-3 col-12">
              <a href="<%#= prefixAdmin %>/products/garbage" class="btn btn-primary w-100 float-end"
                ><i class="bi bi-trash me-2"></i>Thùng rác
              </a>
            </div>
          </div>
        </div>

        <%# } %>
      </div>
    </div>

    <%-include("../../partials/footer.view.ejs") %>

    <form
      action="<%#= prefixAdmin %>/products"
      method="POST"
      class="d-none"
      form-change-status
    ></form>

    <form action="<%#= prefixAdmin %>/products" method="POST" class="d-none" form-delete></form>

    <%# Script File %>
    <script src="/admin/scripts/sidebarToggle.js"></script>
    <script src="/admin/scripts/activeSidebarLink.js"></script>
    <script src="/admin/scripts/statusFilter.js"></script>
    <script src="/admin/scripts/search.js"></script>
    <script src="/admin/scripts/pagination.js"></script>
    <script src="/admin/scripts/displayModalConfirm.js"></script>
    <script src="/admin/scripts/changeStatus.js"></script>
    <script src="/admin/scripts/priceFilter.js"></script>
    <script src="/admin/scripts/delete.js"></script>
    <script src="/admin/scripts/changeMulti.js"></script>
    <script src="/admin/scripts/sort.js"></script>
    <script src="/admin/scripts/showAlert.js"></script>
    <script src="/admin/scripts/toggleAccountInfo.js"></script>

    <%# Script Library & Framwork %>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://kit.fontawesome.com/aaf479b433.js" crossorigin="anonymous"></script>
    <script src="../reload/reload.js"></script>
  </body>
</html>
