<div class="chart-container" style="width: 100%;">
  <canvas class="pie-chart">
    <div class="d-none pie-chart-name" data-value="<%= name %>"></div>
    <div class="d-none pie-chart-labels" data-value="<%= labels %>"></div>
    <div class="d-none pie-chart-data" data-value="<%= data %>"><%= data %></div>
  </canvas>
</div>