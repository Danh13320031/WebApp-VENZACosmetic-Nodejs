<div class="chart-container" style="width: 100%; aspect-ratio: 15 / 5">
  <canvas class="bar-chart">
    <div class="d-none bar-chart-name" data-value="<%= name %>"></div>
    <div class="d-none bar-chart-labels" data-value="<%= labels %>"></div>
    <div class="d-none bar-chart-axis" data-value="<%= axis ? 'x' : 'y' %>"></div>
    <div class="d-none bar-chart-data" data-value="<%= data %>"><%= data %></div>
  </canvas>
</div>
